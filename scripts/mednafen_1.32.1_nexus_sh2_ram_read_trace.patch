+void FirestaffTraceSH2RAMRead(uint32 address, unsigned size, uint32 value)
+{
+ static FILE *file;
+ static unsigned count;
+ static unsigned limit = 100000;
+ static bool configured;
+ static uint32 minimum;
+ static uint32 maximum;
+ static uint32 required_pc;
+ const char *path = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_READS");
+ if(!configured)
+ {
+  const char *min_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_READ_MIN");
+  const char *max_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_READ_MAX");
+  const char *pc_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_READ_PC");
+  const char *limit_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_READ_LIMIT");
+  minimum = min_text && *min_text ? strtoul(min_text, NULL, 0) : 0;
+  maximum = max_text && *max_text ? strtoul(max_text, NULL, 0) : 0;
+  required_pc = pc_text && *pc_text ? strtoul(pc_text, NULL, 0) : 0;
+  if(limit_text && *limit_text) limit = strtoul(limit_text, NULL, 10);
+  configured = true;
+ }
+ if(!path || !*path || count >= limit ||
+    (maximum > minimum && (address < minimum || address >= maximum)) ||
+    (required_pc && FirestaffGetSH2PC(0) != required_pc))
+  return;
+ if(!file)
+ {
+  file = fopen(path, "wb");
+  if(!file) return;
+  fputs("FIRESTAFF_NEXUS_SH2_RAM_READ_TRACE_V1\n", file);
+ }
+ fprintf(file, "addr=0x%08x size=%u value=0x%08x pc0=0x%08x pc1=0x%08x\n",
+  (unsigned)address, size, (unsigned)value,
+  (unsigned)FirestaffGetSH2PC(0), (unsigned)FirestaffGetSH2PC(1));
+ count++;
+ if((count & 0x3ffU) == 0) fflush(file);
+}
