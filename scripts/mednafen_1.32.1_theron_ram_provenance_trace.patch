@@ -116,6 +116,100 @@
 static FILE *TheronPCECDMainRAMTargetTrace;
 static unsigned TheronPCECDMainRAMTargetTraceCount;
 static FILE *TheronPCECDMainRAMLoaderWriteTrace;
 static unsigned TheronPCECDMainRAMLoaderWriteTraceCount;
+struct TheronPCECDMainRAMProvenance
+{
+ bool valid;
+ uint8 value;
+ uint32 source_lba;
+ uint16 source_offset;
+ uint64 fifo_sequence;
+};
+static TheronPCECDMainRAMProvenance TheronPCECDMainRAMProvenanceMap[0x8000];
+static TheronPCECDMainRAMProvenance TheronPCECDPendingRAMProvenance;
+static uint32 TheronPCECDPendingRAMSourcePhysical;
+static uint16 TheronPCECDPendingRAMReaderPC;
+static uint32 TheronPCECDPendingRAMReaderPhysicalPC;
+static FILE *TheronPCECDRAMProvenanceTrace;
+static unsigned TheronPCECDRAMProvenanceTraceCount;
+
+static FILE *TheronPCECDGetRAMProvenanceTrace(void)
+{
+ if(!TheronPCECDRAMProvenanceTrace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_RAM_PROVENANCE_TRACE");
+  if(!path || !*path)
+   return NULL;
+  TheronPCECDRAMProvenanceTrace = fopen(path, "w");
+  if(TheronPCECDRAMProvenanceTrace)
+   fputs("source=mednafen-pce-instrumented-ram-provenance\n", TheronPCECDRAMProvenanceTrace);
+ }
+ return TheronPCECDRAMProvenanceTrace;
+}
+
+void TheronPCECDTraceSeedMainRAMProvenance(uint32 physical_address, uint8 value,
+                                           uint32 source_lba, uint16 source_offset,
+                                           uint64 fifo_sequence)
+{
+ if(physical_address < 0x1f0000 || physical_address >= 0x1f8000)
+  return;
+ TheronPCECDMainRAMProvenance *entry = &TheronPCECDMainRAMProvenanceMap[physical_address - 0x1f0000];
+ entry->valid = true;
+ entry->value = value;
+ entry->source_lba = source_lba;
+ entry->source_offset = source_offset;
+ entry->fifo_sequence = fifo_sequence;
+ FILE *trace = TheronPCECDGetRAMProvenanceTrace();
+ if(trace && TheronPCECDRAMProvenanceTraceCount < 4096)
+ {
+  fprintf(trace, "theron_ram_provenance_seed sequence=%u source_lba=%u source_offset=%u fifo_sequence=%llu physical_address=%06x value=%02x\n",
+          TheronPCECDRAMProvenanceTraceCount++, source_lba, source_offset,
+          (unsigned long long)fifo_sequence, physical_address, value);
+  fflush(trace);
+ }
+}
+
+void TheronPCECDTraceMainRAMProvenanceRead(uint32 physical_address, uint8 value,
+                                           uint16 reader_pc, uint32 reader_physical_pc)
+{
+ TheronPCECDPendingRAMProvenance.valid = false;
+ if(physical_address < 0x1f0000 || physical_address >= 0x1f8000)
+  return;
+ TheronPCECDMainRAMProvenance *entry = &TheronPCECDMainRAMProvenanceMap[physical_address - 0x1f0000];
+ if(!entry->valid || entry->value != value)
+  return;
+ TheronPCECDPendingRAMProvenance = *entry;
+ TheronPCECDPendingRAMSourcePhysical = physical_address;
+ TheronPCECDPendingRAMReaderPC = reader_pc;
+ TheronPCECDPendingRAMReaderPhysicalPC = reader_physical_pc;
+}
+
+void TheronPCECDTraceMainRAMProvenanceWrite(uint16 logical_address,
+                                            uint32 physical_address, uint8 value,
+                                            uint16 writer_pc, uint32 writer_physical_pc)
+{
+ if(physical_address < 0x1f0000 || physical_address >= 0x1f8000)
+  return;
+ TheronPCECDMainRAMProvenance *entry = &TheronPCECDMainRAMProvenanceMap[physical_address - 0x1f0000];
+ bool copied = TheronPCECDPendingRAMProvenance.valid &&
+               TheronPCECDPendingRAMProvenance.value == value;
+ if(copied)
+ {
+  *entry = TheronPCECDPendingRAMProvenance;
+  FILE *trace = TheronPCECDGetRAMProvenanceTrace();
+  if(trace && TheronPCECDRAMProvenanceTraceCount < 4096)
+  {
+   fprintf(trace, "theron_ram_provenance_copy sequence=%u source_lba=%u source_offset=%u fifo_sequence=%llu source_physical=%06x destination_physical=%06x destination_logical=%04x reader_pc=%04x reader_physical_pc=%06x writer_pc=%04x writer_physical_pc=%06x value=%02x\n",
+           TheronPCECDRAMProvenanceTraceCount++, entry->source_lba, entry->source_offset,
+           (unsigned long long)entry->fifo_sequence, TheronPCECDPendingRAMSourcePhysical,
+           physical_address, logical_address, TheronPCECDPendingRAMReaderPC,
+           TheronPCECDPendingRAMReaderPhysicalPC, writer_pc, writer_physical_pc, value);
+   fflush(trace);
+  }
+ }
+ else if(!entry->valid || entry->value != value)
+  entry->valid = false;
+ TheronPCECDPendingRAMProvenance.valid = false;
+}
 static FILE *TheronPCECDSpawnConsumerTrace;
