diff --git a/src/pce/pcecd.cpp b/src/pce/pcecd.cpp
--- a/src/pce/pcecd.cpp
+++ b/src/pce/pcecd.cpp
@@ -115,0 +116,181 @@
+struct TheronPCECDMainRAMProvenance
+{
+ bool valid;
+ uint8 value;
+ uint32 source_lba;
+ uint16 source_offset;
+ uint64 fifo_sequence;
+};
+static TheronPCECDMainRAMProvenance TheronPCECDMainRAMProvenanceMap[0x200000];
+static TheronPCECDMainRAMProvenance TheronPCECDPendingRAMProvenance;
+static uint32 TheronPCECDPendingRAMSourcePhysical;
+static uint16 TheronPCECDPendingRAMReaderPC;
+static uint32 TheronPCECDPendingRAMReaderPhysicalPC;
+static FILE *TheronPCECDRAMProvenanceTrace;
+static unsigned TheronPCECDRAMProvenanceTraceCount;
+
+static FILE *TheronPCECDGetRAMProvenanceTrace(void)
+{
+ if(!TheronPCECDRAMProvenanceTrace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_RAM_PROVENANCE_TRACE");
+  if(!path || !*path)
+   return NULL;
+  TheronPCECDRAMProvenanceTrace = fopen(path, "w");
+  if(TheronPCECDRAMProvenanceTrace)
+   fputs("source=mednafen-pce-instrumented-ram-provenance\n", TheronPCECDRAMProvenanceTrace);
+ }
+ return TheronPCECDRAMProvenanceTrace;
+}
+
+void TheronPCECDTraceSeedMainRAMProvenance(uint32 physical_address, uint8 value,
+                                           uint32 source_lba, uint16 source_offset,
+                                           uint64 fifo_sequence)
+{
+ if(physical_address < 0x0c0000 || physical_address >= 0x200000)
+  return;
+ TheronPCECDMainRAMProvenance *entry = &TheronPCECDMainRAMProvenanceMap[physical_address];
+ entry->valid = true;
+ entry->value = value;
+ entry->source_lba = source_lba;
+ entry->source_offset = source_offset;
+ entry->fifo_sequence = fifo_sequence;
+ FILE *trace = TheronPCECDGetRAMProvenanceTrace();
+ if(trace && TheronPCECDRAMProvenanceTraceCount < 4096)
+ {
+  fprintf(trace, "theron_ram_provenance_seed sequence=%u source_lba=%u source_offset=%u fifo_sequence=%llu physical_address=%06x value=%02x\n",
+          TheronPCECDRAMProvenanceTraceCount++, source_lba, source_offset,
+          (unsigned long long)fifo_sequence, physical_address, value);
+  fflush(trace);
+ }
+}
+
+bool TheronPCECDTraceTakeDataRead(uint16 *reader_pc, uint32 *reader_physical_pc,
+                                  uint8 *value, uint32 *source_lba,
+                                  uint16 *source_offset, uint64 *fifo_sequence);
+void TheronPCECDTraceMainRAMProvenanceRead(uint32 physical_address, uint8 value,
+                                           uint16 reader_pc, uint32 reader_physical_pc)
+{
+ TheronPCECDPendingRAMProvenance.valid = false;
+ if(physical_address < 0x0c0000 || physical_address >= 0x200000)
+  return;
+ TheronPCECDMainRAMProvenance *entry = &TheronPCECDMainRAMProvenanceMap[physical_address];
+ if(!entry->valid || entry->value != value)
+  return;
+ TheronPCECDPendingRAMProvenance = *entry;
+ TheronPCECDPendingRAMSourcePhysical = physical_address;
+ TheronPCECDPendingRAMReaderPC = reader_pc;
+ TheronPCECDPendingRAMReaderPhysicalPC = reader_physical_pc;
+}
+
+void TheronPCECDTraceMainRAMProvenanceWrite(uint16 logical_address,
+                                            uint32 physical_address, uint8 value,
+                                            uint16 writer_pc, uint32 writer_physical_pc)
+{
+ static int direct_origin_enabled = -1;
+ if(direct_origin_enabled < 0)
+ {
+  const char *setting = getenv("FIRESTAFF_THERON_RAM_PROVENANCE_DIRECT");
+  direct_origin_enabled = setting && setting[0] == '1';
+ }
+ if(direct_origin_enabled && physical_address < 0x1f0000 &&
+    physical_address >= 0x0c0000)
+ {
+  uint16 reader_pc;
+  uint32 reader_physical_pc;
+  uint8 read_value;
+  uint32 source_lba;
+  uint16 source_offset;
+  uint64 fifo_sequence;
+  if(TheronPCECDTraceTakeDataRead(&reader_pc, &reader_physical_pc, &read_value,
+                                  &source_lba, &source_offset, &fifo_sequence) &&
+     read_value == value)
+  {
+   TheronPCECDTraceSeedMainRAMProvenance(physical_address, value, source_lba,
+                                         source_offset, fifo_sequence);
+   FILE *direct_trace = TheronPCECDGetRAMProvenanceTrace();
+   if(direct_trace)
+   {
+    fprintf(direct_trace, "theron_ram_provenance_direct source_lba=%u source_offset=%u fifo_sequence=%llu destination_physical=%06x destination_logical=%04x reader_pc=%04x reader_physical_pc=%06x writer_pc=%04x writer_physical_pc=%06x value=%02x\n",
+            source_lba, source_offset, (unsigned long long)fifo_sequence,
+            physical_address, logical_address, reader_pc, reader_physical_pc,
+            writer_pc, writer_physical_pc, value);
+    fflush(direct_trace);
+   }
+  }
+ }
+ if(physical_address < 0x0c0000 || physical_address >= 0x200000)
+  return;
+ TheronPCECDMainRAMProvenance *entry = &TheronPCECDMainRAMProvenanceMap[physical_address];
+ bool copied = TheronPCECDPendingRAMProvenance.valid &&
+               TheronPCECDPendingRAMProvenance.value == value;
+ if(copied)
+ {
+  *entry = TheronPCECDPendingRAMProvenance;
+  FILE *trace = TheronPCECDGetRAMProvenanceTrace();
+  if(trace && TheronPCECDRAMProvenanceTraceCount < 4096)
+  {
+   fprintf(trace, "theron_ram_provenance_copy sequence=%u source_lba=%u source_offset=%u fifo_sequence=%llu source_physical=%06x destination_physical=%06x destination_logical=%04x reader_pc=%04x reader_physical_pc=%06x writer_pc=%04x writer_physical_pc=%06x value=%02x\n",
+           TheronPCECDRAMProvenanceTraceCount++, entry->source_lba, entry->source_offset,
+           (unsigned long long)entry->fifo_sequence, TheronPCECDPendingRAMSourcePhysical,
+           physical_address, logical_address, TheronPCECDPendingRAMReaderPC,
+           TheronPCECDPendingRAMReaderPhysicalPC, writer_pc, writer_physical_pc, value);
+   fflush(trace);
+  }
+ }
+ else if(!entry->valid || entry->value != value)
+  entry->valid = false;
+ TheronPCECDPendingRAMProvenance.valid = false;
+}
+static FILE *TheronPCECDRecordWatchTrace;
+static unsigned TheronPCECDRecordWatchTraceCount;
+static bool TheronPCECDRecordWatchAddress(uint16 logical_address)
+{
+ return (logical_address >= 0x6000 && logical_address < 0x6100) ||
+        (logical_address >= 0x611d && logical_address <= 0x6126) ||
+        (logical_address >= 0x2935 && logical_address <= 0x293e);
+}
+static FILE *TheronPCECDGetRecordWatchTrace(void)
+{
+ if(!TheronPCECDRecordWatchTrace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_RECORD_WATCH_TRACE");
+  if(!path || !*path)
+   return NULL;
+  TheronPCECDRecordWatchTrace = fopen(path, "w");
+  if(TheronPCECDRecordWatchTrace)
+   fputs("source=mednafen-pce-instrumented-record-watch\n",
+         TheronPCECDRecordWatchTrace);
+ }
+ return TheronPCECDRecordWatchTrace;
+}
+void TheronPCECDTraceRecordWatchRead(uint16 logical_address,
+                                     uint32 physical_address, uint8 value,
+                                     uint16 reader_pc, uint32 reader_physical_pc)
+{
+ if(!TheronPCECDRecordWatchAddress(logical_address))
+  return;
+ FILE *trace = TheronPCECDGetRecordWatchTrace();
+ if(trace && TheronPCECDRecordWatchTraceCount < 16384)
+ {
+  fprintf(trace, "theron_record_watch op=read logical_address=%04x physical_address=%06x value=%02x pc=%04x physical_pc=%06x\n",
+          logical_address, physical_address, value, reader_pc, reader_physical_pc);
+  fflush(trace);
+  TheronPCECDRecordWatchTraceCount++;
+ }
+}
+void TheronPCECDTraceRecordWatchWrite(uint16 logical_address,
+                                      uint32 physical_address, uint8 value,
+                                      uint16 writer_pc, uint32 writer_physical_pc)
+{
+ if(!TheronPCECDRecordWatchAddress(logical_address))
+  return;
+ FILE *trace = TheronPCECDGetRecordWatchTrace();
+ if(trace && TheronPCECDRecordWatchTraceCount < 16384)
+ {
+  fprintf(trace, "theron_record_watch op=write logical_address=%04x physical_address=%06x value=%02x pc=%04x physical_pc=%06x\n",
+          logical_address, physical_address, value, writer_pc, writer_physical_pc);
+  fflush(trace);
+  TheronPCECDRecordWatchTraceCount++;
+ }
+}
