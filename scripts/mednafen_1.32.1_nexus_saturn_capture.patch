+static void FirestaffCaptureFrame(void)
+{
+ const char *path;
+ if(!FirestaffCaptureConfigured)
+ {
+  const char *skip = getenv("FIRESTAFF_NEXUS_TRACE_SKIP_FRAMES");
+  const char *limit = getenv("FIRESTAFF_NEXUS_TRACE_FRAME_LIMIT");
+  if(skip && *skip) FirestaffCaptureSkipTarget = (unsigned)strtoul(skip, NULL, 10);
+  if(limit && *limit) FirestaffCaptureFrameLimit = (unsigned)strtoul(limit, NULL, 10);
+  if(!FirestaffCaptureFrameLimit) FirestaffCaptureFrameLimit = 1;
+  FirestaffCaptureConfigured = true;
+ }
+ if(FirestaffCaptureSkippedFrames < FirestaffCaptureSkipTarget)
+ {
+  FirestaffCaptureSkippedFrames++;
+  return;
+ }
+ if(FirestaffCaptureFrames >= FirestaffCaptureFrameLimit) return;
+ path = getenv("FIRESTAFF_NEXUS_TRACE_OUTPUT");
+ if(!path || !*path) return;
+ if(!FirestaffCaptureFile) FirestaffCaptureFile = fopen(path, "wb");
+ if(!FirestaffCaptureFile) return;
+ if(FirestaffCaptureFrames == 0)
+  fputs("FIRESTAFF_NEXUS_SATURN_RUNTIME_CAPTURE_V1\n", FirestaffCaptureFile);
+ fprintf(FirestaffCaptureFile, "frame=%u\n", FirestaffCaptureFrames);
+ VDP1::FirestaffCaptureRaw(FirestaffCaptureFile);
+ fputs("VDP2_RAW\n", FirestaffCaptureFile);
+ fwrite(RawRegs, sizeof(RawRegs[0]), sizeof(RawRegs) / sizeof(RawRegs[0]), FirestaffCaptureFile);
+ fwrite(VRAM, sizeof(VRAM[0]), sizeof(VRAM) / sizeof(VRAM[0]), FirestaffCaptureFile);
+ fwrite(CRAM, sizeof(CRAM[0]), sizeof(CRAM) / sizeof(CRAM[0]), FirestaffCaptureFile);
+ fflush(FirestaffCaptureFile);
+ FirestaffCaptureFrames++;
