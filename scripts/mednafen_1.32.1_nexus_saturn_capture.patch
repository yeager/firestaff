+static void FirestaffCaptureFrame(void)
+{
+ const char *path;
+ if(FirestaffCaptureFrames >= 2) return;
+ path = getenv("FIRESTAFF_NEXUS_TRACE_OUTPUT");
+ if(!path || !*path) return;
+ if(!FirestaffCaptureFile) FirestaffCaptureFile = fopen(path, "wb");
+ if(!FirestaffCaptureFile) return;
+ if(FirestaffCaptureFrames == 0)
+  fputs("FIRESTAFF_NEXUS_SATURN_RUNTIME_CAPTURE_V1\n", FirestaffCaptureFile);
