+static void TheronTraceFileSelectScrollRAMWrite(uint32 physical, uint8 value)
+{
+ static FILE *trace = NULL;
+ static unsigned count = 0;
+ const unsigned offset = physical & 0x1fff;
+ uint16 pc;
+ uint32 physical_pc;
+ if(!TheronFileSelectInputIssued() ||
+    (offset != 0x020c && offset != 0x020d &&
+     offset != 0x0210 && offset != 0x0211) || count >= 1024)
+  return;
+ if(!trace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_FILE_SELECT_SCROLL_RAM_TRACE");
+  if(!path || !*path)
+   return;
+  trace = fopen(path, "w");
+  if(!trace)
+   return;
+  fputs("source=mednafen-pce-instrumented-file-select-scroll-ram\n", trace);
+ }
+ pc = HuCPU.GetRegister(HuC6280::GSREG_PC);
+ physical_pc =
+  (HuCPU.GetRegister(HuC6280::GSREG_MPR0 + (pc >> 13)) << 13) |
+  (pc & 0x1fff);
+ fprintf(trace,
+         "file_select_scroll_ram_write sequence=%u frame=%u logical_address=%04x physical_address=%06x old=%02x value=%02x writer_pc=%04x writer_physical_pc=%06x a=%02x x=%02x y=%02x\n",
+         count++, TheronScriptInputFrame(), offset + 0x2000, physical,
+         BaseRAM[offset], value, pc, physical_pc,
+         HuCPU.GetRegister(HuC6280::GSREG_A),
+         HuCPU.GetRegister(HuC6280::GSREG_X),
+         HuCPU.GetRegister(HuC6280::GSREG_Y));
+ fflush(trace);
+}
+
 static DECLFW(BaseRAMWrite)
 {
  TheronTracePCECDDataDestination(A, V);
+ TheronTraceFileSelectScrollRAMWrite(A, V);
  BaseRAM[A & 0x1FFF] = V;
 }

