+static uint16 theron_script_key_mask(const char *key, size_t key_length)
+{
+ /* Mednafen's PCE_GamepadIDII vector order is the wire-state layout:
+  * I, II, SELECT, RUN, UP, RIGHT, DOWN, LEFT.  The constructor's numeric
+  * arguments are ConfigOrder values, not bit offsets. */
+ if(key_length == 1 && key[0] == 'i') return 0x0001;
+ if(key_length == 2 && !strncmp(key, "ii", 2)) return 0x0002;
+ if(key_length == 6 && !strncmp(key, "select", 6)) return 0x0004;
+ if(key_length == 3 && !strncmp(key, "run", 3)) return 0x0008;
+ if(key_length == 2 && !strncmp(key, "up", 2)) return 0x0010;
+ if(key_length == 5 && !strncmp(key, "right", 5)) return 0x0020;
+ if(key_length == 4 && !strncmp(key, "down", 4)) return 0x0040;
+ if(key_length == 4 && !strncmp(key, "left", 4)) return 0x0080;
+ return 0;
+}
