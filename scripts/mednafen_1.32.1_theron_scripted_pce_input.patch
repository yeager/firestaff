+static bool theron_script_boot_applied = false;
+static uint16 theron_script_boot_original_port0 = 0;
+
+static uint16 theron_script_key_mask(const char *key, size_t key_length)
+{
+ if(key_length == 1 && key[0] == 'i') return 0x1000;
+ if(key_length == 2 && !strncmp(key, "ii", 2)) return 0x0800;
+ if(key_length == 6 && !strncmp(key, "select", 6)) return 0x0010;
+ if(key_length == 3 && !strncmp(key, "run", 3)) return 0x0020;
+ if(key_length == 2 && !strncmp(key, "up", 2)) return 0x0001;
+ if(key_length == 4 && !strncmp(key, "down", 4)) return 0x0002;
+ if(key_length == 4 && !strncmp(key, "left", 4)) return 0x0004;
+ if(key_length == 5 && !strncmp(key, "right", 5)) return 0x0008;
+ return 0;
+}
+
@@ -161,0 +181,19 @@
+ if(port == 0 && ptr && !theron_script_boot_applied)
+ {
+  const char *script = getenv("FIRESTAFF_THERON_REPLAY_INPUT_SCRIPT");
+  const char *at = script ? strchr(script, '@') : NULL;
+  const char *comma = at ? strchr(at + 1, ',') : NULL;
+  const size_t key_length = at ? (size_t)(at - script) : 0;
+  char *end = NULL;
+  unsigned long frame = at ? strtoul(at + 1, &end, 10) : 0;
+  uint16 mask = theron_script_key_mask(script, key_length);
+  if(at && frame == 1 && mask && end &&
+     (*end == ':' || *end == ',' || *end == 0) &&
+     (!comma || end == comma))
+  {
+   theron_script_boot_original_port0 = MDFN_de16lsb(ptr);
+   MDFN_en16lsb(ptr, theron_script_boot_original_port0 | mask);
+   theron_script_boot_applied = true;
+  }
+ }
+
@@ -180,0 +219,14 @@
+ static bool theron_script_initialized = false;
+ static bool theron_script_valid = false;
+ static unsigned theron_script_frame = 0;
+ static unsigned theron_script_event_count = 0;
+ static uint16 theron_script_original_port0 = 0;
+ static bool theron_script_applied = false;
+ static struct
+ {
+  unsigned frame;
+  unsigned duration;
+  uint16 mask;
