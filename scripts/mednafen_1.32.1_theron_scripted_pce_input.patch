+ } theron_script_events[32];
@@ -193,0 +246,102 @@
+ if(!theron_script_initialized)
+ {
+  const char *script = getenv("FIRESTAFF_THERON_REPLAY_INPUT_SCRIPT");
+  const char *cursor = script;
+  theron_script_initialized = true;
+  theron_script_valid = script && *script;
+  while(theron_script_valid && *cursor && theron_script_event_count < 32)
+  {
+   const char *at = strchr(cursor, '@');
+   const char *next = at ? strchr(at + 1, ',') : NULL;
+   const size_t key_length = at ? (size_t)(at - cursor) : 0;
+   char *end = NULL;
+   unsigned long frame;
+   unsigned long duration = 1;
+   uint16 mask = 0;
+   if(!at || key_length == 0 || key_length >= sizeof(theron_script_events[0].key))
+   {
+    theron_script_valid = false;
+    break;
+   }
+   frame = strtoul(at + 1, &end, 10);
+   if(end && *end == ':')
+    duration = strtoul(end + 1, &end, 10);
+   if(!frame || !duration || end != (next ? next : at + strlen(at)))
+   {
+    theron_script_valid = false;
+    break;
+   }
+   mask = theron_script_key_mask(cursor, key_length);
+   if(!mask)
+   {
+    theron_script_valid = false;
+    break;
+   }
+   if(theron_script_event_count && frame <= theron_script_events[theron_script_event_count - 1].frame)
+   {
+    theron_script_valid = false;
+    break;
+   }
+   theron_script_events[theron_script_event_count].frame = (unsigned)frame;
+   theron_script_events[theron_script_event_count].duration = (unsigned)duration;
+   theron_script_events[theron_script_event_count].mask = mask;
+   theron_script_events[theron_script_event_count].emitted = false;
+   memcpy(theron_script_events[theron_script_event_count].key, cursor, key_length);
+   theron_script_events[theron_script_event_count].key[key_length] = 0;
+   theron_script_event_count++;
+   cursor = next ? next + 1 : at + strlen(at);
+  }
+  if(theron_script_valid && (!theron_script_event_count || *cursor))
+   theron_script_valid = false;
+  if(theron_input_trace && script && *script)
+  {
+   fprintf(theron_input_trace, "source=mednafen-pce-scripted-input\n");
+   fprintf(theron_input_trace, "scripted_pce_input_plan valid=%u events=%u\n",
+           theron_script_valid ? 1 : 0, theron_script_event_count);
+   fflush(theron_input_trace);
+  }
+ }
+ if(theron_script_applied)
+ {
+  MDFN_en16lsb(data_ptr[0], theron_script_original_port0);
+  theron_script_applied = false;
+ }
+ if(theron_script_boot_applied)
+ {
+  MDFN_en16lsb(data_ptr[0], theron_script_boot_original_port0);
+  theron_script_boot_applied = false;
+ }
+ if(theron_script_valid)
+ {
+  uint16 scripted_mask = 0;
+  for(unsigned event_index = 0; event_index < theron_script_event_count; event_index++)
+  {
+   const unsigned start = theron_script_events[event_index].frame;
+   const unsigned duration = theron_script_events[event_index].duration;
+   if(!theron_script_events[event_index].emitted && theron_script_frame == start)
+   {
+    if(theron_input_trace)
+     fprintf(theron_input_trace, "scripted_pce_input_event frame=%u key=%s mask=%04x hold=%u\n",
+             theron_script_frame, theron_script_events[event_index].key,
+             theron_script_events[event_index].mask, duration);
+    theron_script_events[event_index].emitted = true;
+   }
+   if(theron_script_frame >= start && theron_script_frame - start < duration)
+    scripted_mask |= theron_script_events[event_index].mask;
+  }
+  if(scripted_mask)
+  {
+   const uint16 physical_mask = MDFN_de16lsb(data_ptr[0]);
+   MDFN_en16lsb(data_ptr[0], physical_mask | scripted_mask);
+   theron_script_original_port0 = physical_mask;
+   theron_script_applied = true;
+   if(theron_input_trace)
+   {
+    fprintf(theron_input_trace, "scripted_pce_input_apply frame=%u physical=%04x scripted=%04x combined=%04x\n",
+            theron_script_frame, physical_mask, scripted_mask,
+            (uint16)(physical_mask | scripted_mask));
+    fflush(theron_input_trace);
+   }
+  }
+ }
+ theron_script_frame++;
