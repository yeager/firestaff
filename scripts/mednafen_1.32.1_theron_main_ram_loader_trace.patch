+static FILE *TheronMainRAMLoaderTrace;
+static bool TheronMainRAMLoaderTraceInitialized;
+static unsigned TheronMainRAMLoaderTraceCount;
+
+static void TheronTraceMainRAMLoaderOperation(uint16 logical_pc, uint32 physical_pc, uint8 opcode,
+                                              uint16 first, uint16 second, uint16 third,
+                                              uint8 accumulator, uint8 x, uint8 y)
+{
+ if(!TheronMainRAMLoaderTraceInitialized)
+ {
+  TheronMainRAMLoaderTraceInitialized = true;
+  const char *path = getenv("FIRESTAFF_THERON_MAIN_RAM_LOADER_TRACE");
+  if(path && *path)
+  {
+   TheronMainRAMLoaderTrace = fopen(path, "w");
+   if(TheronMainRAMLoaderTrace)
+   {
+    fprintf(TheronMainRAMLoaderTrace, "source=mednafen-pce-instrumented-main-ram-loader\\n");
+    fflush(TheronMainRAMLoaderTrace);
+   }
+  }
+ }
+ if(!TheronMainRAMLoaderTrace || TheronMainRAMLoaderTraceCount >= 96)
+  return;
+
+ if(opcode == 0x20)
+ {
+  fprintf(TheronMainRAMLoaderTrace, "main_ram_loader_jsr logical_pc=%04x physical_pc=%06x target=%04x a=%02x x=%02x y=%02x\n",
+          logical_pc, physical_pc, first, accumulator, x, y);
+ }
+ else if(opcode == 0x73 || opcode == 0xc3 || opcode == 0xd3 || opcode == 0xe3 || opcode == 0xf3)
+ {
+  const char *operation = opcode == 0x73 ? "tii" : opcode == 0xc3 ? "tdd" :
+                          opcode == 0xd3 ? "tin" : opcode == 0xe3 ? "tia" : "tai";
+  fprintf(TheronMainRAMLoaderTrace, "main_ram_loader_block_transfer logical_pc=%04x physical_pc=%06x operation=%s source=%04x destination=%04x length=%04x\n",
+          logical_pc, physical_pc, operation, first, second, third);
+ }
+ else
+  return;
+
+ TheronMainRAMLoaderTraceCount++;
+ fflush(TheronMainRAMLoaderTrace);
+}
