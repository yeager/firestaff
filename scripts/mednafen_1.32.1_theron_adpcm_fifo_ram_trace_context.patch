+
+static void TheronTracePCECDAdpcm(const char *format, ...)
+{
+ va_list args;
+ if(TheronPCECDAdpcmTraceCount >= 4096)
+  return;
+ if(!TheronPCECDAdpcmTrace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_IRQ2_CD_TRACE");
+  if(!path || !*path)
+   return;
+  TheronPCECDAdpcmTrace = fopen(path, "a");
+  if(!TheronPCECDAdpcmTrace)
+   return;
+  fputs("source=mednafen-pce-instrumented-adpcm-fifo\n", TheronPCECDAdpcmTrace);
+ }
+ va_start(args, format);
+ vfprintf(TheronPCECDAdpcmTrace, format, args);
+ va_end(args);
+ fflush(TheronPCECDAdpcmTrace);
+ TheronPCECDAdpcmTraceCount++;
 }
