diff --git a/src/pce/pce.cpp b/src/pce/pce.cpp
--- a/src/pce/pce.cpp
+++ b/src/pce/pce.cpp
@@ -111,8 +111,40 @@ static DECLFR(BaseRAMReadSGX)
  return(BaseRAM[A & 0x7FFF]);
 }

+extern bool TheronPCECDTraceTakeDataRead(uint16 *reader_pc, uint8 *value);
+
+static void TheronTracePCECDDataDestination(uint32 physical, uint8 stored_value)
+{
+ static FILE *trace = NULL;
+ static unsigned trace_count = 0;
+ uint16 reader_pc;
+ uint8 read_value;
+
+ if(!TheronPCECDTraceTakeDataRead(&reader_pc, &read_value) || trace_count >= 256)
+  return;
+if(read_value != stored_value)
+ return;
+ if(!trace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_IRQ2_CD_TRACE");
+  if(!path || !*path)
+   return;
+  trace = fopen(path, "a");
+  if(!trace)
+   return;
+  fputs("source=mednafen-pce-instrumented-cd-transfer\n", trace);
+ }
+ fprintf(trace,
+         "pce_cd_data_destination_candidate reader_pc=%04x logical_destination=%04x physical=%08x read_value=%02x stored_value=%02x\n",
+         reader_pc, HuCPU.GetLastLogicalWriteAddr(), physical, read_value,
+         stored_value);
+ fflush(trace);
+ trace_count++;
+}
+
 static DECLFW(BaseRAMWriteSGX)
 {
+ TheronTracePCECDDataDestination(A, V);
  BaseRAM[A & 0x7FFF] = V;
 }

@@ -123,6 +151,7 @@ static DECLFR(BaseRAMRead)

 static DECLFW(BaseRAMWrite)
 {
+ TheronTracePCECDDataDestination(A, V);
  BaseRAM[A & 0x1FFF] = V;
 }

