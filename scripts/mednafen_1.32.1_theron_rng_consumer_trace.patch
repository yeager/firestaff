diff --git a/src/drivers/debugger.cpp b/src/drivers/debugger.cpp
--- a/src/drivers/debugger.cpp
+++ b/src/drivers/debugger.cpp
@@ -175,3 +175,22 @@
 static FILE *TheronIrq2TraceSpawnRegisters;
 static unsigned TheronIrq2TraceSpawnRegisterSamples;
+static FILE *TheronIrq2TraceRngConsumer;
+static unsigned TheronIrq2TraceRngWindowSequence;
+static unsigned TheronIrq2TraceRngWindowStep;
+static unsigned TheronIrq2TraceRngWindowRemaining;
+static unsigned TheronIrq2TraceRngSampleLimit = 512;
+static bool TheronIrq2TraceRngSampleLimitInitialized;
+/* Bound complete source windows as well as samples within each window. */
+static unsigned TheronIrq2TraceRngWindowLimit = 32;
+static unsigned TheronIrq2TraceRngEntrySP;
+static unsigned TheronIrq2TraceRngReturnPC;
+static FILE *TheronIrq2TraceRngCode;
+static bool TheronIrq2TraceRngCodeSeen[8];
+static FILE *TheronIrq2TraceRngState;
+static unsigned TheronIrq2TraceRngStateSequence;
+static unsigned TheronIrq2TraceRngStateEntrySP;
+static unsigned TheronIrq2TraceRngStateCallerPC;
+static unsigned TheronIrq2TraceRngStateCallerPhysicalPC;
+static bool TheronIrq2TraceRngStateActive;
+static FILE *TheronIrq2TraceRngGeneratorContext;
 static unsigned TheronIrq2TraceSpawnRegisterSampleLimit = 2048;
@@ -196,9 +215,229 @@
 static void DoTheronIrq2Trace(const uint32 PC)
 {
  if(!TheronIrq2Trace || MDFN_strazicmp(CurGame->shortname, "pce"))
   return;
  const RegGroupType *trace_regs = (*CurGame->Debugger->RegGroups)[0];
  const uint32 logical_pc = trace_regs->GetRegister(trace_regs->Regs[0].id, NULL, 0) & 0xffff;
+ static const uint32 rng_entry_pcs[8] = {
+  0x5d64, 0x5d6a, 0x45e3, 0x5a76, 0x5b8f, 0x5ba5, 0xd23a, 0xd0fe
+ };
+ static const char *const rng_entry_names[8] = {
+  "5d64", "5d6a", "45e3", "5a76", "5b8f", "5ba5", "d23a", "d0fe"
+ };
+ unsigned code_slot;
+ for(code_slot = 0; code_slot < 8u &&
+     rng_entry_pcs[code_slot] != logical_pc; ++code_slot) {}
+ const bool rng_entry = code_slot < 8u;
+ const uint32 rng_state_mpr = trace_regs->GetRegister(
+  trace_regs->Regs[6 + (logical_pc >> 13)].id, NULL, 0) & 0xff;
+ const uint32 rng_state_physical_pc =
+  (rng_state_mpr << 13) | (logical_pc & 0x1fff);
+ const bool rng_state_entry = logical_pc == 0x4667 &&
+  rng_state_physical_pc == 0x000d0667;
+ const bool rng_state_return = logical_pc == 0x467e &&
+  rng_state_physical_pc == 0x000d067e && TheronIrq2TraceRngStateActive;
+ if(rng_state_entry || rng_state_return)
+ {
+  const uint32 reg_a = trace_regs->GetRegister(trace_regs->Regs[1].id, NULL, 0) & 0xff;
+  const uint32 reg_sp = trace_regs->GetRegister(trace_regs->Regs[4].id, NULL, 0) & 0xff;
+  if(rng_state_entry)
+  {
+   const uint32 return_low = CurGame->Debugger->MemPeek(
+    0x2100u + ((reg_sp + 1u) & 0xffu), 1, true, true) & 0xff;
+   const uint32 return_high = CurGame->Debugger->MemPeek(
+    0x2100u + ((reg_sp + 2u) & 0xffu), 1, true, true) & 0xff;
+   TheronIrq2TraceRngStateEntrySP = reg_sp;
+   TheronIrq2TraceRngStateCallerPC =
+    (((return_high << 8) | return_low) + 1u) & 0xffffu;
+   const uint32 caller_mpr = trace_regs->GetRegister(
+    trace_regs->Regs[6 + (TheronIrq2TraceRngStateCallerPC >> 13)].id,
+    NULL, 0) & 0xff;
+   TheronIrq2TraceRngStateCallerPhysicalPC =
+    (caller_mpr << 13) | (TheronIrq2TraceRngStateCallerPC & 0x1fff);
+   TheronIrq2TraceRngStateActive = true;
+   if(!TheronIrq2TraceRngGeneratorContext)
+   {
+    const char *path = getenv("FIRESTAFF_THERON_RNG_GENERATOR_CONTEXT_TRACE");
+    if(path && *path)
+    {
+     TheronIrq2TraceRngGeneratorContext = fopen(path, "w");
+     if(TheronIrq2TraceRngGeneratorContext)
+      fputs("source=mednafen-pce-instrumented-rng-generator-context-v1\n",
+            TheronIrq2TraceRngGeneratorContext);
+    }
+   }
+   if(TheronIrq2TraceRngGeneratorContext)
+   {
+    fprintf(TheronIrq2TraceRngGeneratorContext,
+            "rng_generator_context sequence=%u entry_pc=%04x physical_pc=%08x caller_pc=%04x caller_physical_pc=%08x caller_bytes=32 caller_hex=",
+            TheronIrq2TraceRngStateSequence, logical_pc,
+            rng_state_physical_pc, TheronIrq2TraceRngStateCallerPC,
+            TheronIrq2TraceRngStateCallerPhysicalPC);
+    for(unsigned caller_offset = 0; caller_offset < 32u; ++caller_offset)
+     fprintf(TheronIrq2TraceRngGeneratorContext, "%02x",
+             CurGame->Debugger->MemPeek(
+              (TheronIrq2TraceRngStateCallerPC - 8u + caller_offset) & 0xffffu,
+              1, true, true) & 0xff);
+    fputs(" bytes=8192 hex=", TheronIrq2TraceRngGeneratorContext);
+    for(unsigned ram_offset = 0; ram_offset < 8192u; ++ram_offset)
+     fprintf(TheronIrq2TraceRngGeneratorContext, "%02x",
+             CurGame->Debugger->MemPeek(0x2000u + ram_offset, 1,
+                                        true, true) & 0xff);
+    fputc('\n', TheronIrq2TraceRngGeneratorContext);
+    fflush(TheronIrq2TraceRngGeneratorContext);
+   }
+  }
+  if(!TheronIrq2TraceRngState)
+  {
+   const char *path = getenv("FIRESTAFF_THERON_RNG_STATE_TRACE");
+   if(path && *path)
+   {
+    TheronIrq2TraceRngState = fopen(path, "w");
+    if(TheronIrq2TraceRngState)
+     fputs("source=mednafen-pce-instrumented-rng-state-v2\n",
+           TheronIrq2TraceRngState);
+   }
+  }
+  if(TheronIrq2TraceRngState)
+  {
+   fprintf(TheronIrq2TraceRngState,
+    "rng_state_boundary sequence=%u kind=%s pc=%04x physical_pc=%08x caller_pc=%04x caller_physical_pc=%08x a=%02x x=%02x y=%02x p=%02x sp=%02x entry_sp=%02x b0=%02x b1=%02x b3=%02x b4=%02x b5=%02x b6=%02x b8=%02x ba=%02x bb=%02x r28b7=%02x r28b9=%02x r28ba=%02x r28bb=%02x\n",
+    TheronIrq2TraceRngStateSequence,
+    rng_state_entry ? "entry" : "return", logical_pc,
+    rng_state_physical_pc, TheronIrq2TraceRngStateCallerPC,
+    TheronIrq2TraceRngStateCallerPhysicalPC, reg_a,
+    trace_regs->GetRegister(trace_regs->Regs[2].id, NULL, 0) & 0xff,
+    trace_regs->GetRegister(trace_regs->Regs[3].id, NULL, 0) & 0xff,
+    trace_regs->GetRegister(trace_regs->Regs[5].id, NULL, 0) & 0xff,
+    reg_sp, TheronIrq2TraceRngStateEntrySP,
+    CurGame->Debugger->MemPeek(0x20b0, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x20b1, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x20b3, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x20b4, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x20b5, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x20b6, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x20b8, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x20ba, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x20bb, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x28b7, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x28b9, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x28ba, 1, true, true) & 0xff,
+    CurGame->Debugger->MemPeek(0x28bb, 1, true, true) & 0xff);
+   fflush(TheronIrq2TraceRngState);
+  }
+  if(rng_state_return)
+  {
+   TheronIrq2TraceRngStateSequence++;
+   TheronIrq2TraceRngStateActive = false;
+  }
+ }
+ if(rng_entry && TheronIrq2TraceRngWindowSequence <
+                    TheronIrq2TraceRngWindowLimit)
+ {
+  const uint32 code_mpr = trace_regs->GetRegister(
+   trace_regs->Regs[6 + (logical_pc >> 13)].id, NULL, 0) & 0xff;
+  if(!TheronIrq2TraceRngCode)
+  {
+   const char *path = getenv("FIRESTAFF_THERON_RNG_CODE_TRACE");
+   if(path && *path)
+   {
+    TheronIrq2TraceRngCode = fopen(path, "w");
+    if(TheronIrq2TraceRngCode)
+     fputs("source=mednafen-pce-instrumented-rng-code-v1\n",
+           TheronIrq2TraceRngCode);
+   }
+  }
+  if(TheronIrq2TraceRngCode && !TheronIrq2TraceRngCodeSeen[code_slot])
+  {
+   fprintf(TheronIrq2TraceRngCode,
+           "rng_code_window entry=%s logical_pc=%04x physical_pc=%08x bytes=256 hex=",
+           rng_entry_names[code_slot], logical_pc,
+           (code_mpr << 13) | (logical_pc & 0x1fff));
+   for(unsigned code_offset = 0; code_offset < 256; ++code_offset)
+    fprintf(TheronIrq2TraceRngCode, "%02x",
+            CurGame->Debugger->MemPeek(logical_pc + code_offset, 1, true, true) & 0xff);
+   fputc('\n', TheronIrq2TraceRngCode);
+   fflush(TheronIrq2TraceRngCode);
+   TheronIrq2TraceRngCodeSeen[code_slot] = true;
+  }
+  TheronIrq2TraceRngWindowSequence++;
+  TheronIrq2TraceRngWindowStep = 0;
+  if(!TheronIrq2TraceRngSampleLimitInitialized)
+  {
+   const char *limit_text = getenv("FIRESTAFF_THERON_RNG_CONSUMER_SAMPLE_LIMIT");
+   unsigned parsed_limit = 0;
+   if(limit_text && sscanf(limit_text, "%u", &parsed_limit) == 1 &&
+      parsed_limit >= 512u && parsed_limit <= 65536u)
+    TheronIrq2TraceRngSampleLimit = parsed_limit;
+   limit_text = getenv("FIRESTAFF_THERON_RNG_CONSUMER_WINDOW_LIMIT");
+   parsed_limit = 0;
+   if(limit_text && sscanf(limit_text, "%u", &parsed_limit) == 1 &&
+      parsed_limit > 0u && parsed_limit <= 1024u)
+    TheronIrq2TraceRngWindowLimit = parsed_limit;
+   TheronIrq2TraceRngSampleLimitInitialized = true;
+  }
+  TheronIrq2TraceRngWindowRemaining = TheronIrq2TraceRngSampleLimit;
+  TheronIrq2TraceRngEntrySP = trace_regs->GetRegister(
+   trace_regs->Regs[4].id, NULL, 0) & 0xff;
+  const uint32 return_low = CurGame->Debugger->MemPeek(
+   0x0100u + ((TheronIrq2TraceRngEntrySP + 1u) & 0xffu), 1, true, true) & 0xff;
+  const uint32 return_high = CurGame->Debugger->MemPeek(
+   0x0100u + ((TheronIrq2TraceRngEntrySP + 2u) & 0xffu), 1, true, true) & 0xff;
+  TheronIrq2TraceRngReturnPC = (((return_high << 8) | return_low) + 1u) & 0xffffu;
+ }
+ if(TheronIrq2TraceRngWindowRemaining > 0)
+ {
+  const uint32 trace_mpr = trace_regs->GetRegister(
+    trace_regs->Regs[6 + (logical_pc >> 13)].id, NULL, 0) & 0xff;
+  const uint32 trace_physical_pc =
+   (trace_mpr << 13) | (logical_pc & 0x1fff);
+  const uint32 reg_a = trace_regs->GetRegister(trace_regs->Regs[1].id, NULL, 0) & 0xff;
+  const uint32 reg_x = trace_regs->GetRegister(trace_regs->Regs[2].id, NULL, 0) & 0xff;
+  const uint32 reg_y = trace_regs->GetRegister(trace_regs->Regs[3].id, NULL, 0) & 0xff;
+  const uint32 reg_sp = trace_regs->GetRegister(trace_regs->Regs[4].id, NULL, 0) & 0xff;
+  const uint32 reg_p = trace_regs->GetRegister(trace_regs->Regs[5].id, NULL, 0) & 0xff;
+  const uint32 reg_mpr0 = trace_regs->GetRegister(trace_regs->Regs[6].id, NULL, 0) & 0xff;
+  const uint32 ram_b3 = CurGame->Debugger->MemPeek(0x00b3, 1, true, true) & 0xff;
+  const uint32 ram_b4 = CurGame->Debugger->MemPeek(0x00b4, 1, true, true) & 0xff;
+  const uint32 ram_b5 = CurGame->Debugger->MemPeek(0x00b5, 1, true, true) & 0xff;
+  const uint32 ram_b6 = CurGame->Debugger->MemPeek(0x00b6, 1, true, true) & 0xff;
+  const uint32 ram_b8 = CurGame->Debugger->MemPeek(0x00b8, 1, true, true) & 0xff;
+  const uint32 ram_ba = CurGame->Debugger->MemPeek(0x00ba, 1, true, true) & 0xff;
+  const uint32 ram_bb = CurGame->Debugger->MemPeek(0x00bb, 1, true, true) & 0xff;
+  const uint32 return_boundary =
+   logical_pc == TheronIrq2TraceRngReturnPC &&
+   reg_sp == ((TheronIrq2TraceRngEntrySP + 2u) & 0xffu);
+  if(!TheronIrq2TraceRngConsumer)
+  {
+   const char *path = getenv("FIRESTAFF_THERON_RNG_CONSUMER_TRACE");
+   if(path && *path)
+   {
+    TheronIrq2TraceRngConsumer = fopen(path, "w");
+    if(TheronIrq2TraceRngConsumer)
+     fprintf(TheronIrq2TraceRngConsumer,
+             "source=mednafen-pce-instrumented-rng-consumer\n"
+             "rng_consumer_sample_limit=%u\n"
+             "rng_consumer_window_limit=%u\n",
+             TheronIrq2TraceRngSampleLimit,
+             TheronIrq2TraceRngWindowLimit);
+   }
+  }
+  if(TheronIrq2TraceRngConsumer)
+  {
+   fprintf(TheronIrq2TraceRngConsumer,
+           "rng_consumer_window sequence=%u step=%u pc=%04x physical_pc=%08x entry=%s a=%02x x=%02x y=%02x sp=%02x p=%02x mpr0=%02x b3=%02x b4=%02x b5=%02x b6=%02x b8=%02x ba=%02x bb=%02x entry_sp=%02x return_pc=%04x return_boundary=%u\n",
+           TheronIrq2TraceRngWindowSequence,
+           TheronIrq2TraceRngWindowStep++, logical_pc, trace_physical_pc,
+           logical_pc == 0x5d64 ? "5d64" :
+           (logical_pc == 0x5d6a ? "5d6a" : "window"),
+           reg_a, reg_x, reg_y, reg_sp, reg_p, reg_mpr0,
+           ram_b3, ram_b4, ram_b5, ram_b6, ram_b8, ram_ba, ram_bb,
+           TheronIrq2TraceRngEntrySP, TheronIrq2TraceRngReturnPC,
+           return_boundary);
+   fflush(TheronIrq2TraceRngConsumer);
+  }
+  --TheronIrq2TraceRngWindowRemaining;
+ }
  /* HuC6280 executes through the eight 8-bit MPR windows. The debugger's
   * register-group order is PC,A,X,Y,SP,P,MPR0..MPR7; reconstruct the bus
   * address from the MPR selected by the logical 8 KiB page. */
