+static void TheronTracePCECDCriticalState(const char *format, ...)
+{
+ va_list args;
+
+ if(TheronPCECDCriticalTraceCount >= 128)
+  return;
+ if(!TheronPCECDStateTrace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_IRQ2_CD_TRACE");
+  if(!path || !*path)
+   return;
+  TheronPCECDStateTrace = fopen(path, "a");
+  if(!TheronPCECDStateTrace)
+   return;
+  fputs("source=mednafen-pce-instrumented-cd-state\n", TheronPCECDStateTrace);
+ }
+ va_start(args, format);
+ vfprintf(TheronPCECDStateTrace, format, args);
+ va_end(args);
+ fflush(TheronPCECDStateTrace);
+ TheronPCECDCriticalTraceCount++;
+}
