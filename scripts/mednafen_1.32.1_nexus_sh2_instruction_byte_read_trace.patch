+void FirestaffTraceSH2InstructionByteRead(unsigned which, unsigned register_index,
+ uint32 address, uint8 value, uint32 pc)
+{
+ static FILE *file;
+ static unsigned count;
+ static unsigned limit = 100000;
+ static bool configured;
+ static uint32 required_pc;
+ const char *path = getenv("FIRESTAFF_NEXUS_TRACE_SH2_INSTRUCTION_BYTE_READS");
+ if(!configured)
+ {
+  const char *pc_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_READ_PC");
+  const char *limit_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_READ_LIMIT");
+  required_pc = pc_text && *pc_text ? strtoul(pc_text, NULL, 0) : 0;
+  if(limit_text && *limit_text) limit = strtoul(limit_text, NULL, 10);
+  configured = true;
+ }
+ if(!path || !*path || count >= limit || which ||
+    (required_pc && pc != required_pc))
+  return;
+ if(!file)
+ {
+  file = fopen(path, "wb");
+  if(!file) return;
+  fputs("FIRESTAFF_NEXUS_SH2_INSTRUCTION_BYTE_READ_TRACE_V1\n", file);
+ }
+ fprintf(file, "addr=0x%08x value=0x%02x pc=0x%08x r=%u\n",
+  (unsigned)address, (unsigned)value, (unsigned)pc, register_index);
+ count++;
+ if((count & 0x3ffU) == 0) fflush(file);
+}
