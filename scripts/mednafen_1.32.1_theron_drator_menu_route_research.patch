+unsigned TheronScriptInputFrame(void);
+uint16 TheronDratorGeneratorInputMask(void)
+{
+ if(TheronDratorGeneratorRouteStage == 0 && TheronDratorMenuStage == 0)
+ {
+  const unsigned phase = TheronScriptInputFrame() % 300u;
+  if(phase >= 1u && phase <= 5u) return 0x0008;
+ }
+ if(TheronDratorGeneratorRouteStage == 1 || TheronDratorGeneratorRouteStage == 3)
+ {
+  const unsigned route_frame = TheronScriptInputFrame() - TheronDratorGeneratorInputStartFrame;
+  const unsigned warmup = TheronDratorGeneratorRouteStage == 1 ? 900 : 120;
+  if(route_frame <= warmup) return 0;
+  const unsigned frame = route_frame - warmup;
+  uint16 mask = 0;
+  /* Controller-only panel discovery.  Stage 3 first returns the cursor to
+   * the upper panel area; alternating rows then sweep horizontally with a
+   * clean Button-I edge at every sample. */
+  if(TheronDratorGeneratorRouteStage == 3 && frame <= 240)
+   return 0x0010;
+  const unsigned scan_frame = frame - 1 -
+                               (TheronDratorGeneratorRouteStage == 3 ? 240 : 0);
+  const unsigned row = scan_frame / 270;
+  const unsigned row_frame = scan_frame % 270;
+  if(row < 10)
+  {
+   if(row_frame < 240)
+   {
+    const unsigned sample_frame = row_frame % 20;
+    if(sample_frame < 15)
+     mask |= (row & 1) ? 0x0080 : 0x0020;
+    else
+     mask |= 0x0001;
+   }
+   else
+    mask |= 0x0040;
+  }
+  return mask;
+ }
+ return 0;
+}
