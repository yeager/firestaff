+if(TheronIrq2TracePostLatchControllerResumeSeen &&
+   logical_pc >= 0xe960 && logical_pc < 0xea40 &&
+   !TheronIrq2TracePostLatchResumeWindowSeen[logical_pc - 0xe960])
