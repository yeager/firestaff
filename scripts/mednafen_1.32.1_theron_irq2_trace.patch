+ }
+
+ if(TheronIrq2TraceFE90TransferPending)
+ {
+  if(logical_pc < 0xfe90 || logical_pc >= 0xff00)
+  {
+   TheronIrq2TraceFE90TransferSeen[TheronIrq2TraceFE90TransferSourcePC - 0xfe90] = true;
+   TheronIrq2Trace->print_format("fe90_transfer_source_pc=%04x source_physical_pc=%08x instruction=%s next_pc=%04x next_physical_pc=%08x\\n",
+                                 TheronIrq2TraceFE90TransferSourcePC, TheronIrq2TraceFE90TransferPhysicalPC, TheronIrq2TraceFE90TransferInstruction, logical_pc, PC);
+   FlushTheronIrq2Trace();
+  }
+  TheronIrq2TraceFE90TransferPending = false;
+ }
+
+ if(TheronIrq2TracePostE98ATransferPending)
+ {
+  if(logical_pc != TheronIrq2TracePostE98ATransferSourcePC)
+  {
+   TheronIrq2TracePostE98ATransferSeen = true;
+   TheronIrq2Trace->print_format("post_e98a_controller_transfer_source_pc=%04x source_physical_pc=%08x instruction=%s next_pc=%04x next_physical_pc=%08x\\n",
+                                 TheronIrq2TracePostE98ATransferSourcePC,
+                                 TheronIrq2TracePostE98ATransferPhysicalPC,
+                                 TheronIrq2TracePostE98ATransferInstruction,
+                                 logical_pc, PC);
+   FlushTheronIrq2Trace();
+  }
+  TheronIrq2TracePostE98ATransferPending = false;
+ }
+
+ /* The debugger callback runs for every HuC6280 instruction.  Do not
+  * inspect memory or write a generic per-PC transcript outside the bounded
+  * System Card / loader windows: that instrumentation itself can otherwise
+  * distort CD timing.  Pending transfer receipts above remain handled before
+  * this filter, so a branch out of a watched window is still captured. */
+ const bool TheronIrq2TraceWatchedPC =
+     (logical_pc >= 0xc800 && logical_pc < 0xce00) ||
+     (logical_pc >= 0xe000 && logical_pc < 0xeb00) ||
+     (logical_pc >= 0xfe00) ||
+     (logical_pc >= 0x4000 && logical_pc < 0x4100);
+ if(!TheronIrq2TraceWatchedPC)
+  return;
+/* Record bounded raw store instructions that can alter the controller state
+ * before the latch. This has no command, payload, or state-machine meaning. */
+if(TheronIrq2TraceRawControllerStateStoreCount < 16)
+{
+ const uint32 opcode = CurGame->Debugger->MemPeek(logical_pc, 1, true, true) & 0xff;
+ if(opcode == 0x8d || opcode == 0x9c || opcode == 0xee || opcode == 0xce)
+ {
+  const uint32 address = (CurGame->Debugger->MemPeek(logical_pc + 1, 1, true, true) & 0xff) |
+                         ((CurGame->Debugger->MemPeek(logical_pc + 2, 1, true, true) & 0xff) << 8);
+  if(address == 0x2241)
+  {
+   const RegGroupType *regs = (*CurGame->Debugger->RegGroups)[0];
+   const uint32 accumulator = regs->GetRegister(regs->Regs[1].id, NULL, 0) & 0xff;
+   TheronIrq2Trace->print_format("system_card_controller_state_store pc=%04x physical_pc=%08x opcode=%02x accumulator=%02x state_before=%02x\\n",
+                                 logical_pc, PC, opcode, accumulator,
+                                 CurGame->Debugger->MemPeek(0x2241, 1, true, true) & 0xff);
+   TheronIrq2TraceRawControllerStateStoreCount++;
+   FlushTheronIrq2Trace();
+  }
+ }
+}
+/* Retain only direct pre-instruction CD register store facts. Indirect and
+ * block-transfer paths remain unclassified, and these rows do not form a
+ * transaction receipt by themselves. */
+if(TheronIrq2TraceRawCDRegisterStoreCount < 16)
+{
+ const uint32 opcode = CurGame->Debugger->MemPeek(logical_pc, 1, true, true) & 0xff;
+ if(opcode == 0x8c || opcode == 0x8d || opcode == 0x8e || opcode == 0x9c || opcode == 0xee || opcode == 0xce)
+ {
+  const uint32 address = (CurGame->Debugger->MemPeek(logical_pc + 1, 1, true, true) & 0xff) |
+                         ((CurGame->Debugger->MemPeek(logical_pc + 2, 1, true, true) & 0xff) << 8);
+  if(address >= 0x1800 && address <= 0x1804)
+  {
+   const RegGroupType *regs = (*CurGame->Debugger->RegGroups)[0];
+   const uint32 accumulator = regs->GetRegister(regs->Regs[1].id, NULL, 0) & 0xff;
+   TheronIrq2Trace->print_format("system_card_cd_register_store pc=%04x physical_pc=%08x opcode=%02x address=%04x accumulator=%02x value_before=%02x\\n",
+                                 logical_pc, PC, opcode, address, accumulator,
+                                 CurGame->Debugger->MemPeek(address, 1, true, true) & 0xff);
+   TheronIrq2TraceRawCDRegisterStoreCount++;
+   FlushTheronIrq2Trace();
+  }
+ }
+}
+/* Retain direct stores to the exact result byte read by the C860 wait loop.
+ * The row is raw instruction evidence only; it assigns no completion reason. */
+if(TheronIrq2TraceRawControllerResultStoreCount < 16)
+{
+ const uint32 opcode = CurGame->Debugger->MemPeek(logical_pc, 1, true, true) & 0xff;
+ if(opcode == 0x8c || opcode == 0x8d || opcode == 0x8e || opcode == 0x9c || opcode == 0xee || opcode == 0xce)
+ {
+  const uint32 address = (CurGame->Debugger->MemPeek(logical_pc + 1, 1, true, true) & 0xff) |
+                         ((CurGame->Debugger->MemPeek(logical_pc + 2, 1, true, true) & 0xff) << 8);
+  if(address == 0x222d)
+  {
+   const RegGroupType *regs = (*CurGame->Debugger->RegGroups)[0];
+   const uint32 accumulator = regs->GetRegister(regs->Regs[1].id, NULL, 0) & 0xff;
+   TheronIrq2Trace->print_format("system_card_controller_result_store pc=%04x physical_pc=%08x opcode=%02x accumulator=%02x value_before=%02x\\n",
+                                 logical_pc, PC, opcode, accumulator,
+                                 CurGame->Debugger->MemPeek(0x222d, 1, true, true) & 0xff);
+   TheronIrq2TraceRawControllerResultStoreCount++;
+   FlushTheronIrq2Trace();
+  }
+ }
+}
+/* Retain only direct writes to the System Card state polled by C897. The
+ * later sample is diagnostic evidence and cannot invent a CD request. */
+if(TheronIrq2TracePostLatchCDRegistersActive &&
+   TheronIrq2TraceControllerStateWriteCount < 8 &&
+   (CurGame->Debugger->MemPeek(logical_pc, 1, true, true) & 0xff) == 0x8d)
+{
+ const uint32 address = (CurGame->Debugger->MemPeek(logical_pc + 1, 1, true, true) & 0xff) |
+                        ((CurGame->Debugger->MemPeek(logical_pc + 2, 1, true, true) & 0xff) << 8);
+ if(address == 0x2241)
+ {
+  const RegGroupType *regs = (*CurGame->Debugger->RegGroups)[0];
+  const uint32 accumulator = regs->GetRegister(regs->Regs[1].id, NULL, 0) & 0xff;
+  TheronIrq2Trace->print_format("system_card_controller_state_write pc=%04x physical_pc=%08x address=2241 accumulator=%02x\\n",
+                                logical_pc, PC, accumulator);
+  TheronIrq2TraceControllerStateWriteCount++;
+  FlushTheronIrq2Trace();
+ }
+}
+if(TheronIrq2TracePostLatchCDRegistersActive &&
+   TheronIrq2TracePostCapCallbackCount >= 0x100000u &&
+   !TheronIrq2TraceControllerStateWaitSampleSeen)
+{
+ const uint32 state_2241 = CurGame->Debugger->MemPeek(0x2241, 1, true, true) & 0xff;
+ TheronIrq2Trace->print_format("system_card_controller_wait_sample callback=%llu state_2241=%02x state_write_count=%u cd_1800=%02x\\n",
+                               (unsigned long long)TheronIrq2TracePostCapCallbackCount,
+                               state_2241, TheronIrq2TraceControllerStateWriteCount,
+                               CurGame->Debugger->MemPeek(0x1800, 1, true, true) & 0xff);
+ TheronIrq2TraceControllerStateWaitSampleSeen = true;
+ FlushTheronIrq2Trace();
+}
+ if(TheronIrq2TracePostCapCallbackCount && TheronIrq2TracePostCapPageSamples < 32 && !TheronIrq2TracePostCapPageSeen[logical_pc >> 8])
+ {
+  TheronIrq2TracePostCapPageSeen[logical_pc >> 8] = true;
+  TheronIrq2TracePostCapPageSamples++;
+  TheronIrq2Trace->print_format("post_cap_page_pc=%04x physical_pc=%08x\n", logical_pc, PC);
+  FlushTheronIrq2Trace();
+ }
+ if(logical_pc >= 0xcc00 && logical_pc < 0xcd00 && !TheronIrq2TraceReturnWindowSeen[logical_pc & 0xff])
+ {
+  uint32 disassembly_pc = logical_pc;
+  char disassembly[256];
+
+  TheronIrq2TraceReturnWindowSeen[logical_pc & 0xff] = true;
+  CurGame->Debugger->Disassemble(disassembly_pc, logical_pc, disassembly);
+  TheronIrq2Trace->print_format("return_window_pc=%04x physical_pc=%08x instruction=%s\n", logical_pc, PC, disassembly);
+  FlushTheronIrq2Trace();
+ }
+ if(logical_pc >= 0xcc00 && logical_pc < 0xcd00 && !TheronIrq2TraceReturnTransferPending && !TheronIrq2TraceReturnTransferSeen[logical_pc & 0xff])
+ {
+  const uint32 opcode = CurGame->Debugger->MemPeek(logical_pc, 1, true, true) & 0xff;
+  if(opcode == 0x20 || opcode == 0x40 || opcode == 0x4c || opcode == 0x60 || opcode == 0x6c || (opcode & 0x1f) == 0x10 || (opcode & 0x0f) == 0x0f)
+  {
+   uint32 disassembly_pc = logical_pc;
+
+   TheronIrq2TraceReturnTransferPending = true;
+   TheronIrq2TraceReturnTransferSourcePC = logical_pc;
+   TheronIrq2TraceReturnTransferPhysicalPC = PC;
+   CurGame->Debugger->Disassemble(disassembly_pc, logical_pc, TheronIrq2TraceReturnTransferInstruction);
+  }
+ }
+
+ if(logical_pc >= 0xe870 && logical_pc < 0xe900 && !TheronIrq2TraceE870WindowSeen[logical_pc & 0xff])
