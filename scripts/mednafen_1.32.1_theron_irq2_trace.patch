+ const uint32 cd_1803 = CurGame->Debugger->MemPeek(0x1803, 1, true, true) & 0xff;
+ const uint32 cd_1804 = CurGame->Debugger->MemPeek(0x1804, 1, true, true) & 0xff;
+
+ if(cd_1800 != TheronIrq2TracePostLatchCD1800 || cd_1801 != TheronIrq2TracePostLatchCD1801 ||
+    cd_1802 != TheronIrq2TracePostLatchCD1802 || cd_1803 != TheronIrq2TracePostLatchCD1803 ||
+    cd_1804 != TheronIrq2TracePostLatchCD1804)
+ {
+  uint32 disassembly_pc = logical_pc;
+  char disassembly[256];
+
+  CurGame->Debugger->Disassemble(disassembly_pc, logical_pc, disassembly);
+  TheronIrq2Trace->print_format("post_latch_cd_change_pc=%04x physical_pc=%08x instruction=%s before_1800=%02x before_1801=%02x before_1802=%02x before_1803=%02x before_1804=%02x cd_1800=%02x cd_1801=%02x cd_1802=%02x cd_1803=%02x cd_1804=%02x\n",
+                                logical_pc, PC, disassembly, TheronIrq2TracePostLatchCD1800,
+                                TheronIrq2TracePostLatchCD1801, TheronIrq2TracePostLatchCD1802,
+                                TheronIrq2TracePostLatchCD1803, TheronIrq2TracePostLatchCD1804,
+                                cd_1800, cd_1801, cd_1802, cd_1803, cd_1804);
+  TheronIrq2TracePostLatchCD1800 = cd_1800;
+  TheronIrq2TracePostLatchCD1801 = cd_1801;
+  TheronIrq2TracePostLatchCD1802 = cd_1802;
+  TheronIrq2TracePostLatchCD1803 = cd_1803;
+  TheronIrq2TracePostLatchCD1804 = cd_1804;
+  TheronIrq2TracePostLatchCDChangeCount++;
+  if(logical_pc == 0xea34 &&
+     TheronIrq2TracePostLatchCD1800 == 0xd0 &&
+     TheronIrq2TracePostLatchCD1801 == 0xff &&
+     TheronIrq2TracePostLatchCD1802 == 0x00)
+   TheronIrq2TracePostLatchFirstExchangeComplete = true;
+  FlushTheronIrq2Trace();
+ }
+}
