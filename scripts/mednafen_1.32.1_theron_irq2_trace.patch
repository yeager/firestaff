+/* Once the live controller flow reaches $e98a, retain the first original
+ * control transfer in its immediate $e98a..$ea3f window. The receipt records
+ * only source/next PCs and instruction text; it assigns no CD or payload role. */
+/* The raw program-counter receipt is the gate. Earlier controller markers
+ * are diagnostic only and must not suppress a real execution of $e98a. */
+if(logical_pc == 0xe98a)
+ TheronIrq2TracePostE98AReached = true;
+if(TheronIrq2TracePostE98AReached && !TheronIrq2TracePostE98ATransferSeen &&
+   !TheronIrq2TracePostE98ATransferPending &&
+   logical_pc >= 0xe98a && logical_pc < 0xea40)
+{
+ const uint32 opcode = CurGame->Debugger->MemPeek(logical_pc, 1, true, true) & 0xff;
+ if(opcode == 0x20 || opcode == 0x40 || opcode == 0x4c || opcode == 0x60 ||
+    opcode == 0x6c || (opcode & 0x1f) == 0x10 || (opcode & 0x0f) == 0x0f)
+ {
+  uint32 disassembly_pc = logical_pc;
+
+  TheronIrq2TracePostE98ATransferPending = true;
+  TheronIrq2TracePostE98ATransferSourcePC = logical_pc;
+  TheronIrq2TracePostE98ATransferPhysicalPC = PC;
+  CurGame->Debugger->Disassemble(disassembly_pc, logical_pc,
+                                 TheronIrq2TracePostE98ATransferInstruction);
+ }
+}
