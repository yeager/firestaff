+/* Local Firestaff evidence hook. It records raw logical-memory snapshots at
+ * known loader PCs; it deliberately assigns no branch or record semantics. */
+static void DoTheronIrq2Trace(const uint32 PC)
+{
+ if(!TheronIrq2Trace || MDFN_strazicmp(CurGame->shortname, "pce"))
+  return;
+ const RegGroupType *trace_regs = (*CurGame->Debugger->RegGroups)[0];
+ const uint32 logical_pc = trace_regs->GetRegister(trace_regs->Regs[0].id, NULL, 0) & 0xffff;
+
+ /* Once the System Card return is observed, retain the raw control edge from
+  * its return target to the next observed CPU PC. This does not classify the
+  * caller, target, or any game transition. */
+ if(TheronIrq2TraceLaterE009PostReturnStepPending)
+ {
+  TheronIrq2Trace->print_format("later_system_card_e009_post_return_step caller_pc=%04x return_pc=%04x record=%06x resume_pc=%04x next_pc=%04x\n",
+                                TheronIrq2TraceLaterE009CallerPC,
+                                TheronIrq2TraceLaterE009CallerPC + 3,
+                                TheronIrq2TraceLaterE009Record,
+                                TheronIrq2TraceLaterE009CallerPC + 3,
+                                logical_pc);
+  TheronIrq2TraceLaterE009PostReturnStepPending = false;
+  FlushTheronIrq2Trace();
+ }
+
+/* Begin recording only after the proven caller reaches C897. The hook reports
+ * raw register changes, deliberately not CD command or payload semantics. */
