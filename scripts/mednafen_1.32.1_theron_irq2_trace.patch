+ const uint32 ram_00e7 = CurGame->Debugger->MemPeek(0x00e7, 1, true, true) & 0xff;
+ const uint32 ram_00f5 = CurGame->Debugger->MemPeek(0x00f5, 1, true, true) & 0xff;
+ const uint32 ram_00f6 = CurGame->Debugger->MemPeek(0x00f6, 1, true, true) & 0xff;
+ const uint32 ram_00f7 = CurGame->Debugger->MemPeek(0x00f7, 1, true, true) & 0xff;
+
+ TheronIrq2TraceFE90WindowSeen[logical_pc - 0xfe90] = true;
