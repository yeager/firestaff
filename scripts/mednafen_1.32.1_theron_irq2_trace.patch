+{
+ TheronIrq2TracePostLatchCDRegistersActive = true;
+ TheronIrq2TracePostLatchCD1800 = CurGame->Debugger->MemPeek(0x1800, 1, true, true) & 0xff;
+ TheronIrq2TracePostLatchCD1801 = CurGame->Debugger->MemPeek(0x1801, 1, true, true) & 0xff;
+ TheronIrq2TracePostLatchCD1802 = CurGame->Debugger->MemPeek(0x1802, 1, true, true) & 0xff;
+ TheronIrq2TracePostLatchCD1803 = CurGame->Debugger->MemPeek(0x1803, 1, true, true) & 0xff;
+ TheronIrq2TracePostLatchCD1804 = CurGame->Debugger->MemPeek(0x1804, 1, true, true) & 0xff;
+ TheronIrq2TracePostLatchCDRegistersBaselineSeen = true;
+ TheronIrq2Trace->print_format("post_latch_cd_baseline_pc=%04x cd_1800=%02x cd_1801=%02x cd_1802=%02x cd_1803=%02x cd_1804=%02x\n",
+                               logical_pc, TheronIrq2TracePostLatchCD1800, TheronIrq2TracePostLatchCD1801,
+                               TheronIrq2TracePostLatchCD1802, TheronIrq2TracePostLatchCD1803,
+                               TheronIrq2TracePostLatchCD1804);
+ FlushTheronIrq2Trace();
+}
+if(TheronIrq2TracePostLatchCDRegistersActive && TheronIrq2TracePostLatchCDRegistersBaselineSeen && TheronIrq2TracePostLatchCDChangeCount < 4)
