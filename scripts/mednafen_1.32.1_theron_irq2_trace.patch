+   TheronIrq2Trace->print_format("c860_transfer_source_pc=%04x source_physical_pc=%08x instruction=%s next_pc=%04x next_physical_pc=%08x\n",
+                                 TheronIrq2TraceC860TransferSourcePC, TheronIrq2TraceC860TransferPhysicalPC, TheronIrq2TraceC860TransferInstruction, logical_pc, PC);
