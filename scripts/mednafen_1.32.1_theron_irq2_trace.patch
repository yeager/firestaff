+/* Local Firestaff evidence hook. It records raw logical-memory snapshots at
+ * known loader PCs; it deliberately assigns no branch or record semantics. */
+static void DoTheronIrq2Trace(const uint32 PC)
+{
+ if(!TheronIrq2Trace || MDFN_strazicmp(CurGame->shortname, "pce"))
+  return;
+const uint32 logical_pc = PC & 0xffff;
+
+ if(TheronIrq2TraceReturnTransferPending)
+ {
+  if(logical_pc < 0xcc00 || logical_pc >= 0xcd00)
+  {
+   TheronIrq2TraceReturnTransferSeen[TheronIrq2TraceReturnTransferSourcePC & 0xff] = true;
+   TheronIrq2Trace->print_format("return_transfer_source_pc=%04x source_physical_pc=%08x instruction=%s next_pc=%04x next_physical_pc=%08x\n",
+                                 TheronIrq2TraceReturnTransferSourcePC, TheronIrq2TraceReturnTransferPhysicalPC, TheronIrq2TraceReturnTransferInstruction, logical_pc, PC);
+   FlushTheronIrq2Trace();
+  }
+  TheronIrq2TraceReturnTransferPending = false;
+ }
+
+ if(TheronIrq2TraceE870TransferPending)
+ {
+  if(logical_pc < 0xe870 || logical_pc >= 0xe900)
+  {
+   TheronIrq2TraceE870TransferSeen[TheronIrq2TraceE870TransferSourcePC & 0xff] = true;
+   TheronIrq2Trace->print_format("e870_transfer_source_pc=%04x source_physical_pc=%08x instruction=%s next_pc=%04x next_physical_pc=%08x\n",
+                                 TheronIrq2TraceE870TransferSourcePC, TheronIrq2TraceE870TransferPhysicalPC, TheronIrq2TraceE870TransferInstruction, logical_pc, PC);
+   FlushTheronIrq2Trace();
+  }
+  TheronIrq2TraceE870TransferPending = false;
+ }
+
+ if(TheronIrq2TraceE490TransferPending)
+ {
+  if(logical_pc < 0xe490 || logical_pc > 0xe520)
+  {
+   TheronIrq2TraceE490TransferSeen[TheronIrq2TraceE490TransferSourcePC - 0xe490] = true;
+   TheronIrq2Trace->print_format("bios_e490_transfer_source_pc=%04x source_physical_pc=%08x instruction=%s next_pc=%04x next_physical_pc=%08x\n",
+                                 TheronIrq2TraceE490TransferSourcePC, TheronIrq2TraceE490TransferPhysicalPC, TheronIrq2TraceE490TransferInstruction, logical_pc, PC);
+   FlushTheronIrq2Trace();
+  }
+  TheronIrq2TraceE490TransferPending = false;
+ }
+
+ if(TheronIrq2TraceE8A5TransferPending)
+ {
+  if(logical_pc < 0xe8a5 || logical_pc > 0xe8e2)
+  {
+   TheronIrq2TraceE8A5TransferSeen[TheronIrq2TraceE8A5TransferSourcePC - 0xe8a5] = true;
+   TheronIrq2Trace->print_format("e8a5_transfer_source_pc=%04x source_physical_pc=%08x instruction=%s next_pc=%04x next_physical_pc=%08x\n",
+                                 TheronIrq2TraceE8A5TransferSourcePC, TheronIrq2TraceE8A5TransferPhysicalPC, TheronIrq2TraceE8A5TransferInstruction, logical_pc, PC);
+   FlushTheronIrq2Trace();
+  }
+  TheronIrq2TraceE8A5TransferPending = false;
+ }
