+static void DoTheronIrq2Trace(const uint32 PC)
+{
+ if(!TheronIrq2Trace || MDFN_strazicmp(CurGame->shortname, "pce"))
+  return;
+
+ const uint32 logical_pc = PC & 0xffff;
+ const uint32 controller[4] = {
+  CurGame->Debugger->MemPeek(0x1800, 1, true, true) & 0xff,
+  CurGame->Debugger->MemPeek(0x1801, 1, true, true) & 0xff,
+  CurGame->Debugger->MemPeek(0x1802, 1, true, true) & 0xff,
+  CurGame->Debugger->MemPeek(0x1803, 1, true, true) & 0xff
+ };
+ const uint32 f5 = CurGame->Debugger->MemPeek(0x00f5, 1, true, true) & 0xff;
+ const uint32 f2 = CurGame->Debugger->MemPeek(0x00f2, 1, true, true) & 0xff;
+ const bool system_card_pc = logical_pc >= 0xe000 && logical_pc < 0xf000;
+ const bool boundary_pc = logical_pc == 0x4093 || logical_pc == 0xe736 ||
+                          logical_pc == 0xe742 || logical_pc == 0xe74c;
+ static bool controller_initialized;
+ static uint32 previous_controller[4];
+ const bool controller_changed = !controller_initialized ||
+  controller[0] != previous_controller[0] || controller[1] != previous_controller[1] ||
+  controller[2] != previous_controller[2] || controller[3] != previous_controller[3];
+
+ if(TheronIrq2TraceSnapshotCount < 4096 &&
+    (boundary_pc || controller_changed ||
+     (system_card_pc && !TheronIrq2TraceSystemCardSeen[logical_pc - 0xe000])))
+ {
+  TheronIrq2TraceSnapshotCount++;
+  TheronIrq2TraceEventSequence++;
+  TheronIrq2Trace->print_format("snapshot seq=%u logical_pc=%04x physical_pc=%08x cd_1800=%02x cd_1801=%02x cd_1802=%02x cd_1803=%02x f5=%02x f2=%02x\n",
+                                TheronIrq2TraceEventSequence, logical_pc, PC,
+                                controller[0], controller[1], controller[2], controller[3], f5, f2);
+ }
+ if(system_card_pc)
+  TheronIrq2TraceSystemCardSeen[logical_pc - 0xe000] = true;
+ controller_initialized = true;
+ previous_controller[0] = controller[0];
+ previous_controller[1] = controller[1];
+ previous_controller[2] = controller[2];
+ previous_controller[3] = controller[3];
+}
+
+void Debugger_GTR_TheronIrq2PCECDWrite(uint32 timestamp, uint32 pc, uint32 phys_addr, uint8 data)
+{
+ if(!TheronIrq2Trace || MDFN_strazicmp(CurGame->shortname, "pce"))
+  return;
+ TheronIrq2TraceEventSequence++;
+ TheronIrq2Trace->print_format("io_write seq=%u timestamp=%u logical_pc=%04x physical_addr=%08x port=%x data=%02x\n",
+                               TheronIrq2TraceEventSequence, timestamp, pc & 0xffff,
+                               phys_addr, phys_addr & 0xf, data);
+}
