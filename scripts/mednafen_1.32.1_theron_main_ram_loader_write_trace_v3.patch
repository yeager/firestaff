+void TheronPCECDTraceMainRAMLoaderWrite(uint16 logical_destination,
+                                        uint32 physical_destination, uint8 value,
+                                        uint16 writer_pc, uint32 writer_physical_pc)
+{
+ if(writer_physical_pc < 0x1f0000 || writer_physical_pc >= 0x1f8000 ||
+    TheronPCECDMainRAMLoaderWriteTraceCount >= 4096)
+  return;
+ if(!TheronPCECDMainRAMLoaderWriteTrace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_MAIN_RAM_LOADER_TRACE");
+  if(!path || !*path)
+   return;
+  TheronPCECDMainRAMLoaderWriteTrace = fopen(path, "a");
+  if(!TheronPCECDMainRAMLoaderWriteTrace)
+   return;
+ }
+ fprintf(TheronPCECDMainRAMLoaderWriteTrace,
+         "main_ram_loader_write sequence=%u dispatch_sequence=unbound logical_destination=%04x physical_destination=%06x value=%02x writer_pc=%04x writer_physical_pc=%06x\n",
+         TheronPCECDMainRAMLoaderWriteTraceCount++, logical_destination,
+         physical_destination, value, writer_pc, writer_physical_pc);
+ fflush(TheronPCECDMainRAMLoaderWriteTrace);
+}
