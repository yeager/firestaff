+  if(!trace)
+   return;
+  fputs("source=mednafen-pce-fast-main-ram-consumer-read event_sequence_source=TheronTraceCDSharedEventSequence\n", trace);
+ }
+ const uint32 event_sequence = TheronTraceCDSharedEventSequence++;
+ fprintf(trace, "main_ram_consumer_read sequence=%u event_sequence=%u logical_address=%04x physical_address=%06x value=%02x reader_pc=%04x reader_physical_pc=%06x reader_code_bytes=%s a=%02x x=%02x y=%02x sp=%02x p=%02x\n",
+         count++, event_sequence, logical_address & 0xFFFF, physical_address, value,
+         TheronTraceInstructionPC, TheronTraceInstructionPhysicalPC,
