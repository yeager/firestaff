+ offset = physical_address & 0x1FFF;
+ const bool target_writer_read = TheronTraceInstructionPC >= 0xEA80 &&
+                                 TheronTraceInstructionPC <= 0xEAB0;
+ const bool target_range_read = target_range_enabled &&
+                                physical_address >= target_range_first &&
+                                physical_address <= target_range_last;
+ if(count >= 65536 || (per_offset[offset] >= 16 && !target_writer_read &&
+                        !target_range_read))
+  return;
+ char reader_code_bytes[17] = "unavailable";
+ if((TheronTraceInstructionPC & 0x1FFF) <= 0x1FF8)
+ {
+  const uint8 *reader_code = (const uint8 *)(HuCPU.FastPageR[
+   TheronTraceInstructionPC >> 13] + TheronTraceInstructionPC);
+  for(unsigned i = 0; i < 8; i++)
+   snprintf(reader_code_bytes + i * 2, 3, "%02x", reader_code[i]);
+ }
+ if(!trace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_MAIN_RAM_CONSUMER_TRACE");
+  if(!path || !*path)
+   return;
