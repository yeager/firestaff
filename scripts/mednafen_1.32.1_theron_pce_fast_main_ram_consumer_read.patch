+  target_range_initialized = true;
+  const char *range_text = getenv("FIRESTAFF_THERON_PCE_FAST_MAIN_RAM_CONSUMER_RANGE");
+  if(range_text && *range_text)
+  {
+   char *separator = NULL;
+   char *end = NULL;
+   unsigned long first = strtoul(range_text, &separator, 16);
+   unsigned long last = 0;
+   if(separator && *separator == '-')
+    last = strtoul(separator + 1, &end, 16);
+   if(separator && *separator == '-' && end && end != separator + 1 && !*end &&
+      first <= last && last <= 0x1FFFFF)
+   {
+    target_range_first = first;
+    target_range_last = last;
+    target_range_enabled = true;
+   }
+  }
