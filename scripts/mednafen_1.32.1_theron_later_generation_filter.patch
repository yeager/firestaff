+static bool TheronPCECDTraceSelectedGeneration(unsigned generation)
+{
+ static bool initialized;
+ static unsigned minimum_generation;
+ if(!initialized)
+ {
+  const char *value = getenv("FIRESTAFF_THERON_FIFO_MIN_GENERATION");
+  if(value && value[0] >= '0' && value[0] <= '9' && value[1] == '\0')
+   minimum_generation = value[0] - '0';
+  initialized = true;
+ }
+ return generation >= minimum_generation;
+}
 
