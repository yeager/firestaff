+void TheronPCECDTraceMainRAMConsumerWrite(uint16 logical_address,
+                                          uint32 physical_address, uint8 value,
+                                          uint16 writer_pc, uint32 writer_physical_pc)
+{
+ static FILE *command_trace;
+ static unsigned command_count;
+ static unsigned input_buffer_count;
+ static bool command_armed;
+ static bool command_complete;
+ if(!command_trace && (logical_address == 0x28b8 || logical_address == 0x28b9))
+ {
+  const char *path = getenv("FIRESTAFF_THERON_COMMAND_RAM_TRACE");
+  if(path && *path)
+  {
+   command_trace = fopen(path, "w");
+   if(command_trace)
+    fputs("FIRESTAFF_THERON_COMMAND_RAM_TRACE_V1\n"
+          "source=mednafen-pce-instrumented-command-ram\n", command_trace);
+  }
+ }
+ if(command_trace && !command_complete &&
+    (logical_address == 0x28b8 || logical_address == 0x28b9))
+ {
+  fprintf(command_trace,
+          "input_buffer_write sequence=%u logical_address=%04x value=%02x writer_pc=%04x writer_physical_pc=%06x\n",
+          input_buffer_count++, logical_address, value, writer_pc,
+          writer_physical_pc);
+  fflush(command_trace);
+ }
+ if(!command_armed && !command_count && logical_address == 0x28b8 &&
+    (value & 0x01))
+ {
+  const char *path = getenv("FIRESTAFF_THERON_COMMAND_RAM_TRACE");
+  if(path && *path)
+  {
+   if(!command_trace) command_trace = fopen(path, "w");
+   if(command_trace)
+   {
+    const char *code_path = getenv("FIRESTAFF_THERON_COMMAND_CODE_SNAPSHOT");
+    const char *before_path = getenv("FIRESTAFF_THERON_COMMAND_RAM_BEFORE_SNAPSHOT");
+    if(code_path && *code_path)
+    {
+     FILE *code_file = fopen(code_path, "wb");
+     if(code_file)
+     {
+      for(unsigned code_offset = 0; code_offset < 65536; code_offset++)
+       fputc(HuCPU.PeekPhysical(0x0d0000 + code_offset), code_file);
+      fclose(code_file);
+     }
+    }
+    if(before_path && *before_path)
+    {
+     FILE *before_file = fopen(before_path, "wb");
+     if(before_file)
+     {
+      for(unsigned ram_offset = 0; ram_offset < 8192; ram_offset++)
+       fputc(HuCPU.PeekPhysical(0x1f0000 + ram_offset), before_file);
+      fclose(before_file);
+     }
+    }
+    command_armed = true;
+    TheronPCECDCommandConsumerArmed = true;
+   }
+  }
+ }
+ if(command_armed && command_count < 65536)
+ {
+  fprintf(command_trace,
+          "command_ram_write sequence=%u logical_address=%04x physical_address=%06x value=%02x writer_pc=%04x writer_physical_pc=%06x\n",
+          command_count++, logical_address, physical_address, value,
+          writer_pc, writer_physical_pc);
+  if(logical_address == 0x2905 && value != 0)
+   TheronPCECDCommandConsumerTypeSeen = true;
+  if(logical_address == 0x2905 && value == 0)
+  {
+   if(TheronPCECDCommandConsumerTypeSeen)
+   {
+    if(TheronPCECDCommandConsumerTrace)
+    {
+     fprintf(TheronPCECDCommandConsumerTrace,
+             "command_consumer_boundary sequence=%u\n",
+             TheronPCECDCommandConsumerTraceCount);
+     fflush(TheronPCECDCommandConsumerTrace);
+    }
+    TheronPCECDCommandConsumerArmed = false;
+   }
+   const char *after_path = getenv("FIRESTAFF_THERON_COMMAND_RAM_AFTER_SNAPSHOT");
+   if(after_path && *after_path)
+   {
+    FILE *after_file = fopen(after_path, "wb");
+    if(after_file)
+    {
+     for(unsigned ram_offset = 0; ram_offset < 8192; ram_offset++)
+      fputc(HuCPU.PeekPhysical(0x1f0000 + ram_offset), after_file);
+     fclose(after_file);
+    }
+   }
+  }
+  if(command_count == 65536)
+  {
+   fputs("command_ram_boundary sequence=65536\n", command_trace);
+   fflush(command_trace);
+   command_armed = false;
+   command_complete = true;
+  }
+ }
+ if(physical_address < 0x1f0000 || physical_address >= 0x1f8000 ||
+    TheronPCECDMainRAMTargetTraceCount >= 4096)
+  return;
+ if(!TheronPCECDMainRAMTargetTrace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_MAIN_RAM_TARGET_TRACE");
+  if(!path || !*path)
+   return;
+  TheronPCECDMainRAMTargetTrace = fopen(path, "w");
+  if(!TheronPCECDMainRAMTargetTrace)
+   return;
+  fputs("source=mednafen-pce-instrumented-main-ram-target\n",
+        TheronPCECDMainRAMTargetTrace);
+ }
+ fprintf(TheronPCECDMainRAMTargetTrace,
+         "main_ram_target_write sequence=%u logical_address=%04x physical_address=%06x value=%02x writer_pc=%04x writer_physical_pc=%06x\n",
+         TheronPCECDMainRAMTargetTraceCount++, logical_address,
+         physical_address, value, writer_pc, writer_physical_pc);
+ fflush(TheronPCECDMainRAMTargetTrace);
+}
