+       "stage2_mpr1_probe sequence=%u pc=%04x physical_pc=%08x mpr1=%02x target_physical_pc=%08x bytes=%s\n",
+       stage2_target_probe_count++, logical_pc, trace_physical_pc, mpr1,
+       target_physical_pc, target_bytes);
+     FlushTheronIrq2Trace();
+    }
+   }
