diff --git a/src/drivers/debugger.cpp b/src/drivers/debugger.cpp
--- a/src/drivers/debugger.cpp
+++ b/src/drivers/debugger.cpp
@@ -994,6 +994,28 @@ static void DoTheronIrq2Trace(const uint32 PC)
     FlushTheronIrq2Trace();
    }
+   if(logical_pc == 0x4ec9 || logical_pc == 0x3a2e)
+   {
+    static unsigned stage2_target_probe_count;
+    if(stage2_target_probe_count < 32)
+    {
+     const uint32 mpr1 = trace_regs->GetRegister(
+       trace_regs->Regs[7].id, NULL, 0) & 0xff;
+     const uint32 target_logical_pc =
+       logical_pc == 0x4ec9 ? 0x3a2e : logical_pc;
