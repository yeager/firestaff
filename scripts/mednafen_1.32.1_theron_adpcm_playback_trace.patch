+static FILE *TheronPCECDAdpcmPlaybackTrace;
+static unsigned TheronPCECDAdpcmPlaybackTraceCount;
+
+static void TheronTracePCECDAdpcmPlayback(const char *format, ...)
+{
+ va_list args;
+ if(TheronPCECDAdpcmPlaybackTraceCount >= 4096)
+  return;
+ if(!TheronPCECDAdpcmPlaybackTrace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_ADPCM_PLAYBACK_TRACE");
+  if(!path || !*path)
+   return;
+  TheronPCECDAdpcmPlaybackTrace = fopen(path, "a");
+  if(!TheronPCECDAdpcmPlaybackTrace)
+   return;
+  fputs("source=mednafen-pce-instrumented-adpcm-playback-v1\n", TheronPCECDAdpcmPlaybackTrace);
+ }
+ va_start(args, format);
+ vfprintf(TheronPCECDAdpcmPlaybackTrace, format, args);
+ va_end(args);
+ fflush(TheronPCECDAdpcmPlaybackTrace);
+ TheronPCECDAdpcmPlaybackTraceCount++;
 }

