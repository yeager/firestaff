+
+static void FirestaffTraceScspRead(uint32 address, unsigned size, uint32 value)
+{
+ const char *path;
+ if(!FirestaffScspReadTraceConfigured)
+ {
+  const char *min_text = getenv("FIRESTAFF_NEXUS_TRACE_SCSP_READ_MIN");
+  const char *max_text = getenv("FIRESTAFF_NEXUS_TRACE_SCSP_READ_MAX");
+  const char *limit = getenv("FIRESTAFF_NEXUS_TRACE_SCSP_READ_LIMIT");
+  if(min_text && *min_text) FirestaffScspReadTraceMin = strtoul(min_text, NULL, 0);
+  if(max_text && *max_text) FirestaffScspReadTraceMax = strtoul(max_text, NULL, 0);
+  if(limit && *limit) FirestaffScspReadTraceLimit = strtoul(limit, NULL, 10);
+  FirestaffScspReadTraceConfigured = true;
+ }
+ if(address < FirestaffScspReadTraceMin || address >= FirestaffScspReadTraceMax ||
+    FirestaffScspReadTraceCount >= FirestaffScspReadTraceLimit)
+  return;
+ path = getenv("FIRESTAFF_NEXUS_TRACE_SCSP_READS");
+ if(!path || !*path) return;
+ if(!FirestaffScspReadTraceFile)
+ {
+  FirestaffScspReadTraceFile = fopen(path, "wb");
+  if(!FirestaffScspReadTraceFile) return;
+  fputs("FIRESTAFF_NEXUS_SCSP_READ_TRACE_V1\n", FirestaffScspReadTraceFile);
+  FirestaffTraceWriteSession(FirestaffScspReadTraceFile, &FirestaffScspReadTraceSessionWritten);
+ }
+ fprintf(FirestaffScspReadTraceFile,
+  "addr=0x%06x size=%u value=0x%08x pc=0x%08x\n",
+  (unsigned)(address & 0x1fffffU), size, (unsigned)value,
+  (unsigned)SoundCPU.PC);
+ FirestaffScspReadTraceCount++;
+ if((FirestaffScspReadTraceCount & 0x3ffU) == 0) fflush(FirestaffScspReadTraceFile);
+}
