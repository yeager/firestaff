--- a/src/pce/input.cpp
+++ b/src/pce/input.cpp
@@ -268,0 +269,28 @@
+ static FILE *theron_input_read_trace = NULL;
+ static unsigned theron_input_read_count = 0;
+ static unsigned theron_input_read_trace_limit = 4096;
+ static bool theron_input_read_trace_limit_initialized = false;
+ if(!theron_input_read_trace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_IRQ2_INPUT_TRACE");
+  if(path && *path)
+   theron_input_read_trace = fopen(path, "a");
+ }
+ if(!theron_input_read_trace_limit_initialized)
+ {
+  const char *limit = getenv("FIRESTAFF_THERON_INPUT_TRACE_LIMIT");
+  if(limit && *limit)
+  {
+   const unsigned parsed_limit = (unsigned)strtoul(limit, NULL, 10);
+   if(parsed_limit)
+    theron_input_read_trace_limit = parsed_limit;
+  }
+  theron_input_read_trace_limit_initialized = true;
+ }
+ if(theron_input_read_trace && theron_input_read_count < theron_input_read_trace_limit)
+ {
+  const uint16 raw = data_ptr[0] ? MDFN_de16lsb(data_ptr[0]) : 0;
+  fprintf(theron_input_read_trace, "pce_input_read cpu_pc=%04x register=%04x raw=%04x sel=%u clr=%u index=%u\n", HuCPU.GetRegister(HuC6280::GSREG_PC), A, raw, SEL ? 1 : 0, CLR ? 1 : 0, read_index);
+  fflush(theron_input_read_trace);
+  theron_input_read_count++;
+ }
@@ -294,0 +323,27 @@
+ static FILE *theron_input_write_trace = NULL;
+ static unsigned theron_input_write_count = 0;
+ static unsigned theron_input_write_trace_limit = 4096;
+ static bool theron_input_write_trace_limit_initialized = false;
+ if(!theron_input_write_trace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_IRQ2_INPUT_TRACE");
+  if(path && *path)
+   theron_input_write_trace = fopen(path, "a");
+ }
+ if(!theron_input_write_trace_limit_initialized)
+ {
+  const char *limit = getenv("FIRESTAFF_THERON_INPUT_TRACE_LIMIT");
+  if(limit && *limit)
+  {
+   const unsigned parsed_limit = (unsigned)strtoul(limit, NULL, 10);
+   if(parsed_limit)
+    theron_input_write_trace_limit = parsed_limit;
+  }
+  theron_input_write_trace_limit_initialized = true;
+ }
+ if(theron_input_write_trace && theron_input_write_count < theron_input_write_trace_limit)
+ {
+  fprintf(theron_input_write_trace, "pce_input_write cpu_pc=%04x register=%04x data=%02x sel_before=%u clr_before=%u index=%u\n", HuCPU.GetRegister(HuC6280::GSREG_PC), A, V, SEL ? 1 : 0, CLR ? 1 : 0, read_index);
+  fflush(theron_input_write_trace);
+  theron_input_write_count++;
+ }
