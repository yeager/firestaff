--- src/ss/vdp2.cpp
+++ src/ss/vdp2.cpp
@@ -103,0 +104,40 @@
+static FILE *FirestaffVdp2WriteTraceFile;
+static unsigned FirestaffVdp2WriteTraceCount;
+static unsigned FirestaffVdp2WriteTraceLimit = 200000;
+static uint32 FirestaffVdp2WriteTraceMin;
+static uint32 FirestaffVdp2WriteTraceMax;
+static bool FirestaffVdp2WriteTraceConfigured;
+
+static void FirestaffTraceVdp2Write(const char *area, uint32 address,
+ unsigned size, uint16 value)
+{
+ const char *path;
+ if(!FirestaffVdp2WriteTraceConfigured)
+ {
+  const char *min_text = getenv("FIRESTAFF_NEXUS_TRACE_VDP2_WRITE_MIN");
+  const char *max_text = getenv("FIRESTAFF_NEXUS_TRACE_VDP2_WRITE_MAX");
+  const char *limit_text = getenv("FIRESTAFF_NEXUS_TRACE_VDP2_WRITE_LIMIT");
+  if(min_text && *min_text) FirestaffVdp2WriteTraceMin = strtoul(min_text, NULL, 0);
+  if(max_text && *max_text) FirestaffVdp2WriteTraceMax = strtoul(max_text, NULL, 0);
+  if(limit_text && *limit_text) FirestaffVdp2WriteTraceLimit = strtoul(limit_text, NULL, 10);
+  FirestaffVdp2WriteTraceConfigured = true;
+ }
+ path = getenv("FIRESTAFF_NEXUS_TRACE_VDP2_WRITES");
+ if(!path || !*path || FirestaffVdp2WriteTraceCount >= FirestaffVdp2WriteTraceLimit ||
+    (FirestaffVdp2WriteTraceMax > FirestaffVdp2WriteTraceMin &&
+     (address < FirestaffVdp2WriteTraceMin || address >= FirestaffVdp2WriteTraceMax)))
+  return;
+ if(!FirestaffVdp2WriteTraceFile)
+ {
+  FirestaffVdp2WriteTraceFile = fopen(path, "wb");
+  if(!FirestaffVdp2WriteTraceFile) return;
+  fputs("FIRESTAFF_NEXUS_VDP2_WRITE_TRACE_V1\n", FirestaffVdp2WriteTraceFile);
+ }
+ fprintf(FirestaffVdp2WriteTraceFile,
+  "area=%s addr=0x%06x size=%u value=0x%04x pc0=0x%08x pc1=0x%08x\n",
+  area, (unsigned)address, size, (unsigned)value,
+  (unsigned)CPU[0].GetRegister(SH7095::GSREG_RPC, NULL, 0),
+  (unsigned)CPU[1].GetRegister(SH7095::GSREG_RPC, NULL, 0));
+ FirestaffVdp2WriteTraceCount++;
+ if((FirestaffVdp2WriteTraceCount & 0x3ffU) == 0) fflush(FirestaffVdp2WriteTraceFile);
+}
+
