+void TheronTracePCEFastCodeRAMWrite(uint32 logical_address,
+                                           uint32 physical_address, uint8 value)
+{
+ static FILE *trace = NULL;
+ static unsigned count = 0;
+ extern uint32 TheronTraceCDSharedEventSequence;
+ if(TheronTraceInstructionPhysicalPC < 0x1F1C00 ||
+    TheronTraceInstructionPhysicalPC >= 0x1F1D00 ||
+    physical_address < 0x0D0000 || physical_address >= 0x0D2000 ||
+    count >= 65536)
+  return;
+ if(!trace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_PCE_FAST_CODE_RAM_WRITE_TRACE");
+  if(!path || !*path)
+   return;
+  trace = fopen(path, "w");
+  if(!trace)
+   return;
+  fputs("source=mednafen-pce-fast-code-ram-write event_sequence_source=TheronTraceCDSharedEventSequence\n", trace);
+ }
+ fprintf(trace,
+         "pce_fast_code_ram_write sequence=%u event_sequence=%u logical_address=%04x physical_address=%06x value=%02x writer_pc=%04x writer_physical_pc=%06x mpr0=%02x mpr1=%02x mpr2=%02x mpr3=%02x mpr4=%02x mpr5=%02x mpr6=%02x mpr7=%02x a=%02x x=%02x y=%02x sp=%02x p=%02x\n",
+         count++, TheronTraceCDSharedEventSequence++, logical_address & 0xFFFF,
+         physical_address, value, TheronTraceInstructionPC,
+         TheronTraceInstructionPhysicalPC, HuCPU.MPR[0], HuCPU.MPR[1],
+         HuCPU.MPR[2], HuCPU.MPR[3], HuCPU.MPR[4], HuCPU.MPR[5],
+         HuCPU.MPR[6], HuCPU.MPR[7], HuCPU.A, HuCPU.X, HuCPU.Y, HuCPU.S,
+         HuCPU.P);
+ fflush(trace);
+}
