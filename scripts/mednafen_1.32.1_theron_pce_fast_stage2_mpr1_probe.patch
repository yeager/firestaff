--- a/src/pce_fast/huc6280.cpp
+++ b/src/pce_fast/huc6280.cpp
@@ -19,1 +19,3 @@
 #include "vdc.h"
+#include <stdio.h>
+#include <stdlib.h>
@@ -29,1 +31,172 @@
 HuC6280 HuCPU;
+
+static void TheronTraceStage2MPR1(const uint16 stage2_probe_pc)
+{
+ static FILE *stage2_mpr1_trace;
+ static int stage2_mpr1_trace_initialized;
+ static unsigned stage2_mpr1_candidate_sequence;
+ static unsigned stage2_mpr1_dispatch_sequence;
+ static unsigned stage2_mpr1_dispatch_observation_sequence;
+ static int stage2_mpr1_dispatch_last_valid;
+ static uint8 stage2_mpr1_dispatch_last_id;
+ static uint16 stage2_mpr1_dispatch_last_target;
+ static unsigned stage2_mpr1_sequence;
+ static unsigned stage2_mpr1_call_sequence;
+ static int stage2_mpr1_call_pending;
+ static unsigned stage2_mpr1_lookup_sequence;
+ static int stage2_mpr1_lookup_pending;
+ static uint8 stage2_mpr1_caller_mpr1;
+ static uint32 stage2_mpr1_caller_physical_pc;
+ static uint32 stage2_mpr1_call_target_physical_pc;
+ static uint8 stage2_mpr1_caller_bytes[3];
+ if(!stage2_mpr1_trace_initialized)
+ {
+  const char *trace_path = getenv("FIRESTAFF_THERON_IRQ2_TRACE");
+  stage2_mpr1_trace_initialized = 1;
+  if(trace_path && *trace_path)
+  {
+   stage2_mpr1_trace = fopen(trace_path, "a");
+   if(stage2_mpr1_trace)
+    fputs("source=mednafen-pce-fast-stage2-mpr1-probe\n", stage2_mpr1_trace);
+  }
+ }
+ if(stage2_probe_pc == 0x4ec9 && stage2_mpr1_trace &&
+    stage2_mpr1_lookup_sequence < 64)
+ {
+  const uint8 *stage2 = (const uint8 *)(HuCPU.FastPageR[2]);
+  const uint8 selector = stage2[0x4d7b];
+  const uint16 slot = (uint16)(0x4d7c + (uint16)selector * 2);
+  fprintf(stage2_mpr1_trace,
+    "stage2_mpr1_lookup sequence=%u pc=4ec9 mpr2=%02x selector=%02x key=%02x slot=%04x slot_bytes=%02x%02x a=%02x x=%02x y=%02x p=%02x\n",
+    stage2_mpr1_lookup_sequence++, HuCPU.MPR[2], selector,
+    stage2[0x4ec2], slot, stage2[slot], stage2[slot + 1],
+    HuCPU.A, HuCPU.X, HuCPU.Y, HuCPU.P);
+  stage2_mpr1_lookup_pending = 1;
+  fflush(stage2_mpr1_trace);
+ }
+ if(stage2_probe_pc == 0x4ed4 && stage2_mpr1_lookup_pending &&
+    stage2_mpr1_trace)
+ {
+  const uint8 *stage2 = (const uint8 *)(HuCPU.FastPageR[2]);
+  const uint8 *zero_page = (const uint8 *)(HuCPU.Page1);
+  const uint16 root = (uint16)zero_page[0] |
+                      ((uint16)zero_page[1] << 8);
+  const uint8 count = *(const uint8 *)(HuCPU.FastPageR[root >> 13] + root);
+  fprintf(stage2_mpr1_trace,
+    "stage2_mpr1_root sequence=%u pc=4ed4 selector=%02x key=%02x root=%04x count=%02x a=%02x x=%02x y=%02x p=%02x\n",
+    stage2_mpr1_lookup_sequence - 1, stage2[0x4d7b], stage2[0x4ec2],
+    root, count, HuCPU.A, HuCPU.X, HuCPU.Y, HuCPU.P);
+  fflush(stage2_mpr1_trace);
+ }
+ if(stage2_probe_pc == 0x4ed7 && stage2_mpr1_lookup_pending &&
+    stage2_mpr1_trace)
+ {
+  const uint8 *stage2 = (const uint8 *)(HuCPU.FastPageR[2]);
+  const uint8 *ram = (const uint8 *)(HuCPU.FastPageR[1] + 0x37ce);
+  fprintf(stage2_mpr1_trace,
+    "stage2_mpr1_result sequence=%u pc=4ed7 selector=%02x key=%02x carry=%u field_37ce=%02x field_37cf=%02x field_37d0=%02x field_37d1=%02x a=%02x x=%02x y=%02x p=%02x\n",
+    stage2_mpr1_lookup_sequence - 1, stage2[0x4d7b], stage2[0x4ec2],
+    HuCPU.P & 0x01, ram[0], ram[1], ram[2], ram[3],
+    HuCPU.A, HuCPU.X, HuCPU.Y, HuCPU.P);
+  stage2_mpr1_lookup_pending = 0;
+  fflush(stage2_mpr1_trace);
+ }
+ if(stage2_mpr1_call_pending && stage2_probe_pc != 0x3a2e)
+  stage2_mpr1_call_pending = 0;
+ if(stage2_probe_pc == 0x4ed4)
+ {
+  const uint8 *caller = (const uint8 *)(HuCPU.FastPageR[2] + stage2_probe_pc);
+  const uint32 caller_mpr2 = HuCPU.MPR[2];
+  for(unsigned int i = 0; i < 3; i++)
+   stage2_mpr1_caller_bytes[i] = caller[i];
+  stage2_mpr1_call_pending =
+    stage2_mpr1_caller_bytes[0] == 0x20 &&
+    stage2_mpr1_caller_bytes[1] == 0x2e &&
+    stage2_mpr1_caller_bytes[2] == 0x3a;
+  stage2_mpr1_caller_mpr1 = HuCPU.MPR[1];
+  stage2_mpr1_caller_physical_pc =
+    (caller_mpr2 << 13) | (stage2_probe_pc & 0x1fff);
+  stage2_mpr1_call_target_physical_pc =
+    (stage2_mpr1_caller_mpr1 << 13) | (0x3a2e & 0x1fff);
+  if(stage2_mpr1_trace && stage2_mpr1_candidate_sequence < 32)
+  {
+   fprintf(stage2_mpr1_trace,
+     "stage2_mpr1_candidate sequence=%u pc=%04x physical_pc=%08x mpr1=%02x callsite_bytes=%02x%02x%02x linked=%u\n",
+     stage2_mpr1_candidate_sequence++, stage2_probe_pc,
+     stage2_mpr1_caller_physical_pc, stage2_mpr1_caller_mpr1,
+     stage2_mpr1_caller_bytes[0], stage2_mpr1_caller_bytes[1],
+     stage2_mpr1_caller_bytes[2], stage2_mpr1_call_pending);
+   fflush(stage2_mpr1_trace);
+  }
+  if(stage2_mpr1_trace && stage2_mpr1_call_pending &&
+     stage2_mpr1_call_sequence < 32)
+  {
+   fprintf(stage2_mpr1_trace,
+     "stage2_mpr1_call sequence=%u pc=%04x physical_pc=%08x mpr1=%02x target_physical_pc=%08x callsite_bytes=%02x%02x%02x linked=%u\n",
+     stage2_mpr1_call_sequence++, stage2_probe_pc,
+     stage2_mpr1_caller_physical_pc, stage2_mpr1_caller_mpr1,
+     stage2_mpr1_call_target_physical_pc, stage2_mpr1_caller_bytes[0],
+     stage2_mpr1_caller_bytes[1], stage2_mpr1_caller_bytes[2],
+     stage2_mpr1_call_pending);
+   fflush(stage2_mpr1_trace);
+  }
+ }
+ if(stage2_probe_pc == 0x3a2e && stage2_mpr1_call_pending)
+ {
+  if(stage2_mpr1_trace && stage2_mpr1_sequence < 32)
+  {
+   const uint32 target_mpr1 = HuCPU.MPR[1];
+   const uint8 *mapped_target = (const uint8 *)(HuCPU.FastPageR[1] + stage2_probe_pc);
+   char target_bytes[129];
+   static const char hex[] = "0123456789abcdef";
+   for(unsigned int i = 0; i < 64; i++)
+   {
+    const uint8 byte = mapped_target[i];
+    target_bytes[i * 2] = hex[byte >> 4];
+    target_bytes[i * 2 + 1] = hex[byte & 0x0f];
+   }
+   target_bytes[128] = 0;
+   fprintf(stage2_mpr1_trace,
+     "stage2_mpr1_exec sequence=%u pc=%04x physical_pc=%08x mpr1=%02x caller_pc=4ed4 caller_physical_pc=%08x caller_mpr1=%02x call_target_physical_pc=%08x linked=%u callsite_bytes=%02x%02x%02x bytes=%s\n",
+     stage2_mpr1_sequence++, stage2_probe_pc,
+     (target_mpr1 << 13) | (stage2_probe_pc & 0x1fff), target_mpr1,
+     stage2_mpr1_caller_physical_pc, stage2_mpr1_caller_mpr1,
+     stage2_mpr1_call_target_physical_pc, stage2_mpr1_call_pending,
+     stage2_mpr1_caller_bytes[0], stage2_mpr1_caller_bytes[1],
+     stage2_mpr1_caller_bytes[2], target_bytes);
+   fflush(stage2_mpr1_trace);
+  }
+  stage2_mpr1_call_pending = 0;
+ }
+ if(stage2_probe_pc == 0x40dc && stage2_mpr1_trace &&
+    stage2_mpr1_dispatch_observation_sequence < 1048576)
+ {
+  const uint8 *stream = (const uint8 *)(HuCPU.FastPageR[0] + 0x1c);
+  const uint8 *table = (const uint8 *)(HuCPU.FastPageR[2] + 0x410d);
+  const uint8 stream_id = stream[0];
+  const uint8 stream_id_high = stream[1];
+  const uint16 table_offset = stream_id * 2;
+  const uint8 target_low = table[table_offset];
+  const uint8 target_high = table[table_offset + 1];
+  const uint16 target = target_low | (target_high << 8);
+  if(stage2_mpr1_dispatch_sequence < 32 &&
+     (!stage2_mpr1_dispatch_last_valid ||
+      stream_id != stage2_mpr1_dispatch_last_id ||
+      target != stage2_mpr1_dispatch_last_target))
+  {
+   fprintf(stage2_mpr1_trace,
+     "stage2_mpr1_dispatch sequence=%u observation=%u pc=40dc physical_pc=%08x mpr2=%02x stream_id=%02x stream_id_high=%02x target=%04x target_mpr=%02x target_physical_pc=%08x table_physical_address=%08x table_bytes=%02x%02x\n",
+     stage2_mpr1_dispatch_sequence++, stage2_mpr1_dispatch_observation_sequence,
+     (HuCPU.MPR[2] << 13) | (0x40dc & 0x1fff), HuCPU.MPR[2],
+     stream_id, stream_id_high, target,
+     HuCPU.MPR[target >> 13],
+     (HuCPU.MPR[target >> 13] << 13) | (target & 0x1fff),
+     (HuCPU.MPR[2] << 13) | (0x010d + table_offset), target_low, target_high);
+   fflush(stage2_mpr1_trace);
+  }
+  stage2_mpr1_dispatch_last_valid = 1;
+  stage2_mpr1_dispatch_last_id = stream_id;
+  stage2_mpr1_dispatch_last_target = target;
+  stage2_mpr1_dispatch_observation_sequence++;
+ }
+}
@@ -692,1 +753,2 @@
-	  b1 = RdAtPC();
+	  TheronTraceStage2MPR1(GetRealPC());
+	  b1 = RdAtPC();
