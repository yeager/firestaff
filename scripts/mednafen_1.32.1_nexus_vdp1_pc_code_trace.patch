--- src/ss/ss.h
+++ src/ss/ss.h
@@ -120,5 +120,6 @@
 MDFN_HIDE extern SH7095 CPU[2];	// for smpc.cpp
 uint32 FirestaffGetSH2PC(unsigned which);
+ uint16 FirestaffPeekSH2Memory(unsigned which, uint32 address);
 MDFN_HIDE extern int32 SH7095_mem_timestamp;
--- src/ss/ss.cpp
+++ src/ss/ss.cpp
@@ -464,5 +464,11 @@
 uint32 FirestaffGetSH2PC(unsigned which)
 {
  return CPU[which & 1U].GetRegister(SH7095::GSREG_RPC, NULL, 0);
+}
+
+uint16 FirestaffPeekSH2Memory(unsigned which, uint32 address)
+{
+ (void)which;
+ return ne16_rbo_be<uint16>(SH7095_FastMap[address >> SH7095_EXT_MAP_GRAN_BITS], address);
 }
