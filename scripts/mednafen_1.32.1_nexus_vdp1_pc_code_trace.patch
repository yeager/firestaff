--- src/ss/vdp1.cpp
+++ src/ss/vdp1.cpp
@@ -1251,0 +1251,50 @@
+static FILE *FirestaffVramCodeTraceFile;
+static bool FirestaffVramCodeTraceWritten;
+
+static void FirestaffTraceVramWriterCode(uint32 address)
+{
+ const char *path = getenv("FIRESTAFF_NEXUS_TRACE_VDP1_WRITER_CODE");
+ const char *target_text = getenv("FIRESTAFF_NEXUS_TRACE_VDP1_WRITER_CODE_AT");
+ const uint32 pc = FirestaffGetSH2PC(0);
+ const uint32 target = target_text && *target_text ? strtoul(target_text, NULL, 0) : 0xFFFFFFFFU;
+ unsigned offset;
+ if(!path || !*path || FirestaffVramCodeTraceWritten || !pc || address != target) return;
+ if(!FirestaffVramCodeTraceFile)
+ {
+  FirestaffVramCodeTraceFile = fopen(path, "wb");
+  if(!FirestaffVramCodeTraceFile) return;
+  fputs("FIRESTAFF_NEXUS_VDP1_WRITER_CODE_TRACE_V1\n", FirestaffVramCodeTraceFile);
+ }
+ fprintf(FirestaffVramCodeTraceFile, "pc=0x%08x vram_addr=0x%05x code_start=0x%08x words=%u code=",
+  (unsigned)pc, (unsigned)address, (unsigned)(pc - 0x40), 48U);
+ for(offset = 0; offset < 48U; ++offset)
+  fprintf(FirestaffVramCodeTraceFile, "%04x%s",
+   (unsigned)FirestaffPeekSH2Memory(0, pc - 0x40 + offset * 2U),
+   offset + 1U == 48U ? "" : ",");
+ fputc('\n', FirestaffVramCodeTraceFile);
+ fflush(FirestaffVramCodeTraceFile);
+ FirestaffVramCodeTraceWritten = true;
+}
+static bool FirestaffVdp1SnapshotWritten;
+static bool FirestaffVdp1SnapshotPending;
+
+static void FirestaffTraceVdp1Snapshot(uint32 address)
+{
+ const char *path = getenv("FIRESTAFF_NEXUS_TRACE_VDP1_SNAPSHOT");
+ const char *target_text = getenv("FIRESTAFF_NEXUS_TRACE_VDP1_SNAPSHOT_AT");
+ const uint32 target = target_text && *target_text ? strtoul(target_text, NULL, 0) : 0xFFFFFFFFU;
+ FILE *file;
+ if(!path || !*path || FirestaffVdp1SnapshotWritten) return;
+ if(!FirestaffVdp1SnapshotPending)
+ {
+  if(address != target) return;
+  FirestaffVdp1SnapshotPending = true;
+  return;
+ }
+ file = fopen(path, "wb");
+ if(!file) return;
+ fputs("FIRESTAFF_NEXUS_VDP1_SNAPSHOT_V1\n", file);
+ FirestaffCaptureRaw(file);
+ fclose(file);
+ FirestaffVdp1SnapshotWritten = true;
+}
