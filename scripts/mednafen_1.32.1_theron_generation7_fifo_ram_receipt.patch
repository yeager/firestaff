@@ -103,6 +103,67 @@
 static bool TheronPCECDDataReadPending;
 static uint16 TheronPCECDDataReadPC;
 static uint8 TheronPCECDDataReadValue;
+static const unsigned TheronPCECDFifoReceiptCapacity = 65536;
+struct TheronPCECDFifoReceipt
+{
+ uint16 reader_pc;
+ uint8 value;
+ unsigned generation;
+ uint64 sequence;
+};
+static TheronPCECDFifoReceipt TheronPCECDFifoReceipts[TheronPCECDFifoReceiptCapacity];
+static unsigned TheronPCECDFifoReceiptHead;
+static unsigned TheronPCECDFifoReceiptCount;
+static uint64 TheronPCECDFifoReceiptSequence;
+static FILE *TheronPCECDFifoReceiptTrace;
+
+static void TheronPCECDTraceFifoReceipt(const char *format, ...)
+{
+ if(!TheronPCECDFifoReceiptTrace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_IRQ2_CD_TRACE");
+  if(!path || !*path)
+   return;
+  TheronPCECDFifoReceiptTrace = fopen(path, "a");
+  if(!TheronPCECDFifoReceiptTrace)
+   return;
+  fputs("source=mednafen-pce-generation7-fifo-destination-receipt\n", TheronPCECDFifoReceiptTrace);
+ }
+ va_list ap;
+ va_start(ap, format);
+ vfprintf(TheronPCECDFifoReceiptTrace, format, ap);
+ va_end(ap);
+ fflush(TheronPCECDFifoReceiptTrace);
+}
+
+static void TheronPCECDQueueFifoReceipt(uint16 reader_pc, uint8 value, unsigned generation)
+{
+ if(TheronPCECDFifoReceiptCount == TheronPCECDFifoReceiptCapacity)
+  return;
+ unsigned index = (TheronPCECDFifoReceiptHead + TheronPCECDFifoReceiptCount) % TheronPCECDFifoReceiptCapacity;
+ TheronPCECDFifoReceipt *receipt = &TheronPCECDFifoReceipts[index];
+ receipt->reader_pc = reader_pc;
+ receipt->value = value;
+ receipt->generation = generation;
+ receipt->sequence = TheronPCECDFifoReceiptSequence++;
+ TheronPCECDFifoReceiptCount++;
+ TheronPCECDTraceFifoReceipt("pce_cd_fifo_read generation=%u fifo_sequence=%llu reader_pc=%04x value=%02x\n",
+                             generation, (unsigned long long)receipt->sequence, reader_pc, value);
+}
+
+void TheronPCECDTraceDataWrite(uint16 logical_destination, uint32 physical_destination, uint8 stored_value)
+{
+ if(!TheronPCECDFifoReceiptCount)
+  return;
+ TheronPCECDFifoReceipt *receipt = &TheronPCECDFifoReceipts[TheronPCECDFifoReceiptHead];
+ if(receipt->value != stored_value)
+  return;
+ TheronPCECDTraceFifoReceipt("pce_cd_fifo_destination_receipt generation=%u fifo_sequence=%llu reader_pc=%04x logical_destination=%04x physical_destination=%06x value=%02x\n",
+                             receipt->generation, (unsigned long long)receipt->sequence,
+                             receipt->reader_pc, logical_destination, physical_destination, stored_value);
+ TheronPCECDFifoReceiptHead = (TheronPCECDFifoReceiptHead + 1) % TheronPCECDFifoReceiptCapacity;
+ TheronPCECDFifoReceiptCount--;
+}
 
