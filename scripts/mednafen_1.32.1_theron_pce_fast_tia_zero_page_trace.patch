+static void TheronTIAZeroPageAccess(const char *access, unsigned int logical, uint8 value)
+{
+ static unsigned count;
+ static bool truncation_reported;
+ if((logical != 0x0002 && logical != 0x0003) ||
+    TheronTraceInstructionPC < 0x4600 || TheronTraceInstructionPC > 0x46FF)
+  return;
+ FILE *trace = TheronTIAByteTraceOpen();
+ if(!trace)
+  return;
+ if(count >= TheronTIAByteTraceLimit)
+ {
+  if(!truncation_reported)
+  {
+   fprintf(trace, "tia_zero_page_truncated after_rows=%u limit=%u\n", count,
+           TheronTIAByteTraceLimit);
+   fflush(trace);
+   truncation_reported = true;
+  }
+  return;
+ }
+ const unsigned int slot = logical >> 13;
+ const uint8 mpr = HuCPU.MPR[slot];
+ const uint32 physical = ((uint32)mpr << 13) | (logical & 0x1FFF);
+ const uint32 event_sequence = TheronTraceCDSharedEventSequence++;
+ fprintf(trace,
+         "tia_zero_page_access event_sequence=%u row=%u access=%s instruction_pc=%04x logical=%04x mpr_slot=%u mpr=%02x physical=%06x value=%02x block_move=%u bmt_src=%04x bmt_dest=%04x bmt_length=%04x alternate=%u\n",
+         event_sequence, count++, access, TheronTraceInstructionPC, logical,
+         slot, mpr, physical, value, HuCPU.in_block_move, HuCPU.bmt_src,
+         HuCPU.bmt_dest, HuCPU.bmt_length, HuCPU.bmt_alternate);
+ fflush(trace);
+}
