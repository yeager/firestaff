+static unsigned TheronPCEFastScriptFrame;
+static void TheronPCEFastScriptInputFrame(uint16 *data)
+{
+ static bool initialized, valid;
+ static struct { unsigned frame, duration; uint16 mask; bool emitted; char key[8]; } events[32];
+ static unsigned count;
+ if(!initialized)
+ {
+  initialized = true;
+  const char *script = getenv("FIRESTAFF_THERON_REPLAY_INPUT_SCRIPT");
+  const char *cursor = script;
+  valid = script && *script;
+  while(valid && *cursor && count < 32)
+  {
+   const char *at = strchr(cursor, '@'), *next = at ? strchr(at + 1, ',') : NULL;
+   size_t length = at ? (size_t)(at - cursor) : 0;
+   char *end = NULL; unsigned long frame, duration = 1; uint16 mask = 0;
+   if(!at || !length || length >= sizeof(events[0].key)) { valid = false; break; }
+   if(length == 1 && cursor[0] == 'i') mask = 1;
+   else if(length == 2 && !strncmp(cursor, "ii", 2)) mask = 2;
+   else if(length == 6 && !strncmp(cursor, "select", 6)) mask = 4;
+   else if(length == 3 && !strncmp(cursor, "run", 3)) mask = 8;
+   else if(length == 2 && !strncmp(cursor, "up", 2)) mask = 16;
+   else if(length == 5 && !strncmp(cursor, "right", 5)) mask = 32;
+   else if(length == 4 && !strncmp(cursor, "down", 4)) mask = 64;
+   else if(length == 4 && !strncmp(cursor, "left", 4)) mask = 128;
+   frame = strtoul(at + 1, &end, 10);
+   if(end && *end == ':') duration = strtoul(end + 1, &end, 10);
+   if(!frame || !duration || frame > UINT_MAX || duration > UINT_MAX ||
+      frame > UINT_MAX - duration || !mask || end != (next ? next : at + strlen(at)) ||
+      (count && frame <= events[count - 1].frame)) { valid = false; break; }
+   events[count].frame = frame; events[count].duration = duration; events[count].mask = mask;
+   events[count].emitted = false; memcpy(events[count].key, cursor, length); events[count].key[length] = 0;
+   count++; cursor = next ? next + 1 : at + strlen(at);
+  }
+  if(valid && (!count || *cursor)) valid = false;
+  TheronPCEFastInputTraceInit();
+  if(TheronPCEFastInputTrace && script && *script)
+   { fprintf(TheronPCEFastInputTrace, "scripted_pce_input_plan valid=%u events=%u\n", valid ? 1 : 0, count); fflush(TheronPCEFastInputTrace); }
+ }
+ unsigned frame = ++TheronPCEFastScriptFrame; uint16 mask = 0;
+ if(valid) for(unsigned i = 0; i < count; i++)
+ {
+  if(!events[i].emitted && frame == events[i].frame)
+  { if(TheronPCEFastInputTrace) fprintf(TheronPCEFastInputTrace, "scripted_pce_input_event frame=%u key=%s mask=%04x hold=%u\n", frame, events[i].key, events[i].mask, events[i].duration); events[i].emitted = true; }
+  if(frame >= events[i].frame && frame - events[i].frame < events[i].duration) mask |= events[i].mask;
+ }
+ if(mask) { *data |= mask; if(TheronPCEFastInputTrace) { fprintf(TheronPCEFastInputTrace, "scripted_pce_input_apply frame=%u scripted=%04x\n", frame, mask); fflush(TheronPCEFastInputTrace); } }
+}
