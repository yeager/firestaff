@@ -554,0 +554,52 @@
+static uint32 FirestaffLastSH2ReadAddress;
+static uint32 FirestaffLastSH2ReadValue;
+static uint32 FirestaffLastSH2ReadLBA;
+static bool FirestaffLastSH2ReadValid;
+
+void FirestaffTraceSH2SourceRead(uint32 address, uint32 value)
+{
+ if(address >= 0x05800000 && address < 0x05900000)
+ {
+  FirestaffLastSH2ReadAddress = address;
+  FirestaffLastSH2ReadValue = value;
+  FirestaffLastSH2ReadLBA = FirestaffNexusCDBLastFIFOReadLBA();
+  FirestaffLastSH2ReadValid = true;
+ }
+}
+
+void FirestaffTraceSH2RAMSourceWrite(uint32 address, unsigned size, uint32 value)
+{
+ static FILE *file;
+ static unsigned count;
+ static unsigned limit = 100000;
+ static bool configured;
+ static uint32 minimum;
+ static uint32 maximum;
+ static uint32 source_lba_minimum;
+ static uint32 source_lba_maximum = 0xFFFFFFFF;
+ const char *path = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_SOURCE_WRITES");
+ const char *limit_text;
+ if(!configured)
+ {
+  const char *min_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_SOURCE_WRITE_MIN");
+  const char *max_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_SOURCE_WRITE_MAX");
+  const char *source_lba_min_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_SOURCE_LBA_MIN");
+  const char *source_lba_max_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_SOURCE_LBA_MAX");
+  minimum = min_text && *min_text ? strtoul(min_text, NULL, 0) : 0;
+  maximum = max_text && *max_text ? strtoul(max_text, NULL, 0) : 0;
+  source_lba_minimum = source_lba_min_text && *source_lba_min_text ? strtoul(source_lba_min_text, NULL, 0) : 0;
+  source_lba_maximum = source_lba_max_text && *source_lba_max_text ? strtoul(source_lba_max_text, NULL, 0) : 0xFFFFFFFF;
+  configured = true;
+ }
+ if(!path || !*path || !FirestaffLastSH2ReadValid ||
+    !((address >= 0x00200000 && address < 0x00300000) ||
+      (address >= 0x06000000 && address < 0x08000000)) ||
+    (maximum > minimum && (address < minimum || address >= maximum)) ||
+    FirestaffLastSH2ReadLBA < source_lba_minimum || FirestaffLastSH2ReadLBA >= source_lba_maximum ||
+    count >= limit)
+  return;
+ limit_text = getenv("FIRESTAFF_NEXUS_TRACE_SH2_RAM_SOURCE_WRITE_LIMIT");
+ if(count == 0 && limit_text && *limit_text) limit = strtoul(limit_text, NULL, 10);
+ if(!file)
+ {
+  file = fopen(path, "wb");
+  if(!file) return;
+  fputs("FIRESTAFF_NEXUS_SH2_RAM_SOURCE_TRACE_V3\n", file);
+ }
+ fprintf(file, "addr=0x%08x size=%u value=0x%08x source=0x%08x source_value=0x%08x source_lba=0x%08x pc0=0x%08x pc1=0x%08x\n",
+  (unsigned)address, size, (unsigned)value,
+  (unsigned)FirestaffLastSH2ReadAddress, (unsigned)FirestaffLastSH2ReadValue, (unsigned)FirestaffLastSH2ReadLBA,
+  (unsigned)FirestaffGetSH2PC(0), (unsigned)FirestaffGetSH2PC(1));
+ count++;
+ if((count & 0x3ffU) == 0) fflush(file);
+}
