diff --git a/src/cdrom/scsicd.cpp b/src/cdrom/scsicd.cpp
index 2171e30..e11d358 100644
--- a/src/cdrom/scsicd.cpp
+++ b/src/cdrom/scsicd.cpp
@@ -70,0 +71,37 @@ static uint32 TheronSCSIReadCommandSectorCount;
+struct TheronSCSIDataOrigin
+{
+ uint32 lba;
+ uint16 offset;
+ uint64 sequence;
+};
+static TheronSCSIDataOrigin TheronSCSIDataOrigins[65536];
+static uint32 TheronSCSIDataOriginRead;
+static uint32 TheronSCSIDataOriginWrite;
+static uint32 TheronSCSIDataOriginCount;
+static uint64 TheronSCSIDataOriginSequence;
+static TheronSCSIDataOrigin TheronSCSILastDataOrigin;
+static bool TheronSCSILastDataOriginValid;
+
+static void TheronSCSIQueueDataOrigin(uint32 lba, uint16 offset, uint32 length)
+{
+ for(uint32 i = 0; i < length; i++)
+ {
+  if(TheronSCSIDataOriginCount >= 65536)
+   break;
+  TheronSCSIDataOrigins[TheronSCSIDataOriginWrite] =
+      {lba, (uint16)(offset + i), TheronSCSIDataOriginSequence++};
+  TheronSCSIDataOriginWrite = (TheronSCSIDataOriginWrite + 1) & 0xffff;
+  TheronSCSIDataOriginCount++;
+ }
+}
+
+bool SCSICD_GetLastDataOrigin(uint32 *source_lba, uint16 *source_offset,
+                              uint64 *fifo_sequence)
+{
+ if(!TheronSCSILastDataOriginValid)
+  return false;
+ *source_lba = TheronSCSILastDataOrigin.lba;
+ *source_offset = TheronSCSILastDataOrigin.offset;
+ *fifo_sequence = TheronSCSILastDataOrigin.sequence;
+ return true;
+}
@@ -2882,0 +2920 @@ static INLINE void RunCDRead(uint32 system_timestamp, int32 run_time)
+     {
@@ -2883,0 +2922,2 @@ static INLINE void RunCDRead(uint32 system_timestamp, int32 run_time)
+      TheronSCSIQueueDataOrigin(SectorAddr, 24, 2048);
+     }
@@ -2884,0 +2925 @@ static INLINE void RunCDRead(uint32 system_timestamp, int32 run_time)
+     {
@@ -2885,0 +2927,2 @@ static INLINE void RunCDRead(uint32 system_timestamp, int32 run_time)
+      TheronSCSIQueueDataOrigin(SectorAddr, 16, 2048);
+     }
@@ -3148,0 +3192,9 @@ uint32 SCSICD_Run(scsicd_timestamp_t system_timestamp)
+      if(TheronSCSIDataOriginCount)
+      {
+       TheronSCSILastDataOrigin = TheronSCSIDataOrigins[TheronSCSIDataOriginRead];
+       TheronSCSIDataOriginRead = (TheronSCSIDataOriginRead + 1) & 0xffff;
+       TheronSCSIDataOriginCount--;
+       TheronSCSILastDataOriginValid = true;
+      }
+      else
+       TheronSCSILastDataOriginValid = false;
