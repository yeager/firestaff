+   const unsigned long parsed_filter = strtoul(filter_text, &filter_end, 16);
+   Theron44D2FastPhysicalPCFilterEnabled = 1;
+   Theron44D2FastPhysicalPCFilter =
+       (filter_end != filter_text && !*filter_end && parsed_filter <= 0x1fffffUL)
+           ? (unsigned)parsed_filter : 0xffffffffU;
+  }
+  Theron44D2FastPhysicalPCFilterInitialized = 1;
+ }
+ return !Theron44D2FastPhysicalPCFilterEnabled ||
+      physical_pc == Theron44D2FastPhysicalPCFilter;
+}
