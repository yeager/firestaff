+
+void FirestaffTraceSMPCRead(unsigned which, uint32 pc_id, uint32 pid,
+ uint32 pc_if, uint32 pif, uint32 rpc, uint32 r0, uint32 r3, uint32 address, uint32 value)
+{
+ static FILE *file;
+ static unsigned count;
+ static unsigned limit = 65536;
+ static bool configured;
+ static uint64 minimum;
+ static uint64 maximum = UINT64_MAX;
+ const char *path = getenv("FIRESTAFF_NEXUS_TRACE_SMPC_READS");
+ const uint64 frame = SMPC_FirestaffCurrentFrame();
+ if(!configured)
+ {
+  const char *limit_text = getenv("FIRESTAFF_NEXUS_TRACE_SMPC_READ_LIMIT");
+  const char *min_text = getenv("FIRESTAFF_NEXUS_TRACE_SMPC_READ_FRAME_MIN");
+  const char *max_text = getenv("FIRESTAFF_NEXUS_TRACE_SMPC_READ_FRAME_MAX");
+  if(limit_text && *limit_text) limit = strtoul(limit_text, NULL, 10);
+  if(min_text && *min_text) minimum = strtoull(min_text, NULL, 10);
+  if(max_text && *max_text) maximum = strtoull(max_text, NULL, 10);
+  configured = true;
+ }
+ if(!path || !*path || count >= limit || address < 0x10 || address > 0x2f ||
+    frame < minimum || frame > maximum)
+  return;
+ if(!file)
+ {
+  file = fopen(path, "wb");
+  if(!file) return;
+  fputs("FIRESTAFF_NEXUS_SMPC_READ_TRACE_V2\n", file);
+ }
+ fprintf(file, "frame=%llu cpu=%u smpc=0x%02x value=0x%02x pc_id=0x%08x pid=0x%04x pc_if=0x%08x pif=0x%04x rpc=0x%08x r0=0x%08x r3=0x%08x\n",
+  (unsigned long long)frame, which & 1U, (unsigned)address, (unsigned)value,
+  (unsigned)pc_id, (unsigned)(pid & 0xFFFF), (unsigned)pc_if,
+  (unsigned)(pif & 0xFFFF), (unsigned)rpc, (unsigned)r0, (unsigned)r3);
+ count++;
+ if((count & 0x3ffU) == 0) fflush(file);
+}
