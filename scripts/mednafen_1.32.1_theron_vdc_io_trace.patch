+/* Optional, side-effect-free VDC port trace used to tie a captured Theron's
+ * Quest screen to the original HuC6280 producer.  The VDC state machine is
+ * deliberately left untouched: this hook only observes the write immediately
+ * before the existing VCE path receives it. */
+static FILE *TheronVDCIOTrace = NULL;
+static unsigned TheronVDCIOTraceCount = 0;
+static unsigned TheronVDCIOTraceLimit = 0;
+static bool TheronVDCIOSnapshotPending = false;
+static unsigned TheronGetVDCIOTraceLimit(void)
+{
+ const char *value;
+ char *end = NULL;
+ unsigned long parsed;
+ if(TheronVDCIOTraceLimit)
+  return TheronVDCIOTraceLimit;
+ TheronVDCIOTraceLimit = 65536;
+ value = getenv("FIRESTAFF_THERON_VDC_IO_TRACE_LIMIT");
+ if(!value || !*value)
+  return TheronVDCIOTraceLimit;
+ parsed = strtoul(value, &end, 10);
+ if(end && !*end && parsed >= 65536 && parsed <= 2097152)
+  TheronVDCIOTraceLimit = (unsigned)parsed;
+ return TheronVDCIOTraceLimit;
+}
+static void TheronTraceVDCIOWrite(uint32 physical, uint8 value)
+{
+ const char *path;
+ uint16 writer_pc;
+ uint32 writer_physical_pc;
+
+ const unsigned trace_limit = TheronGetVDCIOTraceLimit();
+ if(TheronVDCIOTraceCount >= trace_limit)
+  return;
+ if(!TheronVDCIOTrace)
+ {
+  path = getenv("FIRESTAFF_THERON_VDC_IO_TRACE");
+  if(!path || !*path)
+   return;
+  TheronVDCIOTrace = fopen(path, "w");
+  if(!TheronVDCIOTrace)
+   return;
+  fputs("FIRESTAFF_THERON_VDC_IO_TRACE_V1\n", TheronVDCIOTrace);
+  fputs("source=mednafen-pce-instrumented-vdc-io\n", TheronVDCIOTrace);
+ }
+
+ writer_pc = HuCPU.GetRegister(HuC6280::GSREG_PC);
+ writer_physical_pc =
+  (HuCPU.GetRegister(HuC6280::GSREG_MPR0 + (writer_pc >> 13)) << 13) |
+  (writer_pc & 0x1fff);
+ fprintf(TheronVDCIOTrace,
+         "vdc_io_write sequence=%u timestamp=%u logical_address=%04x physical_address=%06x value=%02x writer_pc=%04x writer_physical_pc=%06x a=%02x x=%02x y=%02x\n",
+         TheronVDCIOTraceCount++, HuCPU.Timestamp(), HuCPU.GetLastLogicalWriteAddr(),
+         physical, value, writer_pc, writer_physical_pc,
+         HuCPU.GetRegister(HuC6280::GSREG_A),
+         HuCPU.GetRegister(HuC6280::GSREG_X),
+         HuCPU.GetRegister(HuC6280::GSREG_Y));
+ fflush(TheronVDCIOTrace);
+ if(TheronVDCIOTraceCount == trace_limit)
+  TheronVDCIOSnapshotPending = true;
+}
+
+static void TheronTraceVDCIOPostWrite(void)
+{
+ if(!TheronVDCIOSnapshotPending)
+  return;
+ TheronVDCIOSnapshotPending = false;
+ TheronDumpGraphicsSnapshot();
+ fprintf(TheronVDCIOTrace,
+         "vdc_snapshot_boundary sequence=%u timestamp=%u\n",
+         TheronVDCIOTraceCount, HuCPU.Timestamp());
+ fflush(TheronVDCIOTrace);
+}
