+         count++, address, stage2_target ? address - stage2_first : address - 0x68 * 8192, ROMSpace[address], value,
+         TheronTraceInstructionPC, TheronTraceInstructionPhysicalPC, HuCPU.MPR[2],
+         HuCPU.in_block_move, HuCPU.bmt_src,
+         ((uint32)HuCPU.MPR[(HuCPU.bmt_src >> 13) & 7] << 13) | (HuCPU.bmt_src & 0x1fff),
+         HuCPU.bmt_dest, HuCPU.bmt_length, HuCPU.A, HuCPU.X, HuCPU.Y, HuCPU.S, HuCPU.P,
+         HuCPU.MPR[0], HuCPU.MPR[1], HuCPU.MPR[2], HuCPU.MPR[3],
+         HuCPU.MPR[4], HuCPU.MPR[5], HuCPU.MPR[6], HuCPU.MPR[7]);
+ fflush(trace);
+}
