+static void TheronTraceCDRAMTargetWrite(uint32 address, uint8 value)
+{
+ static FILE *trace = NULL;
+ static unsigned count = 0;
+ const uint32 first = 0x68 * 8192 + 0x089f;
+ const uint32 last = 0x68 * 8192 + 0x08ab;
+ const uint32 stage2_first = 0x80 * 8192;
+ const uint32 stage2_last = stage2_first + 0x10;
+ const bool stage2_target = address >= stage2_first && address <= stage2_last;
+ if((!stage2_target && (address < first || address > last)) || count >= 8192)
+  return;
+ if(!trace)
+ {
+  const char *path = getenv("FIRESTAFF_THERON_PCE_FAST_CD_RAM_TARGET_WRITE_TRACE");
+  if(!path || !*path)
+   return;
+  trace = fopen(path, "w");
