--- src/ss/vdp1.cpp
+++ src/ss/vdp1.cpp
@@ -1329,0 +1330,24 @@
+static bool FirestaffVdp1RegisterTraceWritten;
+static void FirestaffTraceVdp1WriterRegisters(uint32 address)
+{
+ const char *path = getenv("FIRESTAFF_NEXUS_TRACE_VDP1_WRITER_REGS");
+ const char *target_text = getenv("FIRESTAFF_NEXUS_TRACE_VDP1_WRITER_REG_AT");
+ const char *pc_text = getenv("FIRESTAFF_NEXUS_TRACE_VDP1_WRITER_REG_PC");
+ const uint32 target = target_text && *target_text ? strtoul(target_text, NULL, 0) : 0xFFFFFFFFU;
+ const uint32 pc = FirestaffGetSH2PC(0);
+ FILE *file;
+ if(!path || !*path || FirestaffVdp1RegisterTraceWritten || address != target ||
+    (pc_text && *pc_text && pc != strtoul(pc_text, NULL, 0))) return;
+ file = fopen(path, "wb");
+ if(!file) return;
+ fputs("FIRESTAFF_NEXUS_VDP1_WRITER_REGISTER_TRACE_V1\n", file);
+ fprintf(file, "pc=0x%08x vram_addr=0x%05x", (unsigned)pc,
+  (unsigned)address);
+ for(unsigned i = 0; i < 16U; i++)
+  fprintf(file, " r%u=0x%08x", i,
+   (unsigned)CPU[0].GetRegister(SH7095::GSREG_R0 + i, NULL, 0));
+ fputc('\n', file);
+ fclose(file);
+ FirestaffVdp1RegisterTraceWritten = true;
+}
+
 static bool FirestaffVdp1SnapshotWritten;
