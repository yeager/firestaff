 static SimpleFIFO<uint8> *din = NULL;
 
+struct TheronSCSIDataOrigin
+{
+ bool known;
+ uint32 lba;
+ unsigned generation;
+ uint16 byte_offset;
+ uint16 remaining;
+};
+static TheronSCSIDataOrigin TheronSCSIDataOrigins[64];
+static unsigned TheronSCSIDataOriginHead;
+static unsigned TheronSCSIDataOriginCount;
+static bool TheronSCSIDataOriginCurrentKnown;
+static uint32 TheronSCSIDataOriginCurrentLBA;
+static uint16 TheronSCSIDataOriginCurrentOffset;
+static unsigned TheronSCSIDataOriginCurrentGeneration;
+
+static void TheronSCSITraceResetDataOrigins(void)
+{
+ TheronSCSIDataOriginHead = 0;
+ TheronSCSIDataOriginCount = 0;
+ TheronSCSIDataOriginCurrentKnown = false;
+}
+
+static void TheronSCSITraceQueueDataOrigin(bool known, uint32 lba,
+                                           unsigned generation, uint16 bytes)
+{
+ if(!bytes || TheronSCSIDataOriginCount == 64)
+ {
+  TheronSCSITraceResetDataOrigins();
+  return;
+ }
+ unsigned index = (TheronSCSIDataOriginHead + TheronSCSIDataOriginCount) & 63;
+ TheronSCSIDataOrigins[index].known = known;
+ TheronSCSIDataOrigins[index].lba = lba;
+ TheronSCSIDataOrigins[index].generation = generation;
+ TheronSCSIDataOrigins[index].byte_offset = 0;
+ TheronSCSIDataOrigins[index].remaining = bytes;
+ TheronSCSIDataOriginCount++;
+}
+
+static void TheronSCSITraceAdvanceDataOrigin(void)
+{
+ TheronSCSIDataOriginCurrentKnown = false;
+ if(!TheronSCSIDataOriginCount)
+  return;
+ TheronSCSIDataOrigin *origin = &TheronSCSIDataOrigins[TheronSCSIDataOriginHead];
+ TheronSCSIDataOriginCurrentKnown = origin->known;
+ TheronSCSIDataOriginCurrentLBA = origin->lba;
+ TheronSCSIDataOriginCurrentOffset = origin->byte_offset;
+ TheronSCSIDataOriginCurrentGeneration = origin->generation;
+ origin->byte_offset++;
+ origin->remaining--;
+ if(!origin->remaining)
+ {
+  TheronSCSIDataOriginHead = (TheronSCSIDataOriginHead + 1) & 63;
+  TheronSCSIDataOriginCount--;
+ }
+}
+
+bool TheronSCSITraceCurrentDataOrigin(uint32 *lba, uint16 *byte_offset,
+                                      unsigned *generation)
+{
+ if(!TheronSCSIDataOriginCurrentKnown)
+  return false;
+ *lba = TheronSCSIDataOriginCurrentLBA;
+ *byte_offset = TheronSCSIDataOriginCurrentOffset;
+ *generation = TheronSCSIDataOriginCurrentGeneration;
+ return true;
+}
