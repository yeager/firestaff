#: src/ui/menu_startup_m12.c:775
msgid "CHAMPIONS ENTER THE DUNGEON"
msgstr "챔피언들이 던전에 들어서다"

#: src/ui/menu_startup_m12.c:775
msgid "FOUR PORTRAITS BECOME A PARTY"
msgstr "네 개의 초상화가 파티가 되다"

#: src/ui/menu_startup_m12.c:775
msgid "REAL TIME PRESSURE DEFINES THE LEGEND"
msgstr "실시간 압박감이 전설을 정의하다"

#: src/ui/menu_startup_m12.c:775
msgid "THE FIRESTAFF IS THE CENTRAL RELIC"
msgstr "파이어스태프는 핵심 유물이다"

#: src/ui/menu_startup_m12.c:776
msgid "KEY LORE THREADS"
msgstr "핵심 이야기 갈래"

#: src/ui/menu_startup_m12.c:776
msgid "LORD CHAOS SHATTERS ORDER"
msgstr "카오스 경이 질서를 무너뜨리다"

#: src/ui/menu_startup_m12.c:776
msgid "RA RETURNS AS MASTER OF BALANCE"
msgstr "라가 균형의 지배자로 돌아오다"

#: src/ui/menu_startup_m12.c:776
msgid "THE DUNGEON IS BOTH TEST AND PRISON"
msgstr "던전은 시험이자 감옥이다"

#: src/ui/menu_startup_m12.c:776
msgid "THE GREY LORD IS DIVIDED"
msgstr "그레이 로드는 분열되어 있다"

#: src/ui/menu_startup_m12.c:777
msgid "FIRESTAFF RECORDS EVIDENCE NOT GUESSWORK"
msgstr "Firestaff는 추측이 아닌 증거를 기록한다"

#: src/ui/menu_startup_m12.c:777
msgid "GRAPHICS DAT AND DUNGEON DAT ARE VERIFIED"
msgstr "GRAPHICS.DAT와 DUNGEON.DAT가 검증되었다"

#: src/ui/menu_startup_m12.c:777
msgid "HASHED ORIGINAL DATA STAYS USER SUPPLIED"
msgstr "해시로 검증된 오리지널 데이터는 사용자가 직접 제공한다"

#: src/ui/menu_startup_m12.c:777
msgid "PC AND ATARI ST LINEAGE MATTERS"
msgstr "PC와 아타리 ST 계보가 중요하다"

#: src/ui/menu_startup_m12.c:777
msgid "PRESERVATION NOTES"
msgstr "보존 기록"

#: src/ui/menu_startup_m12.c:783
msgid "THE CHAMPIONS RETURN"
msgstr "챔피언들이 돌아오다"

#: src/ui/menu_startup_m12.c:785
msgid "CSB REWARDS MAP MEMORY AND NERVE"
msgstr "CSB는 지도 기억력과 담력을 보상한다"

#: src/ui/menu_startup_m12.c:785
msgid "DUNGEON MASTER SYSTEMS BECOME DENSER"
msgstr "Dungeon Master의 시스템이 더 촘촘해지다"

#: src/ui/menu_startup_m12.c:785
msgid "EXPANSION AND SEQUEL DESIGN"
msgstr "확장판이자 속편으로서의 설계"

#: src/ui/menu_startup_m12.c:785
msgid "FOUR PATHS TEST MASTERY"
msgstr "네 갈래 길이 숙련도를 시험하다"

#: src/ui/menu_startup_m12.c:785
msgid "THE CORBUM QUEST REPLACES SIMPLE DESCENT"
msgstr "코르붐 탐색이 단순한 하강을 대신하다"

#: src/ui/menu_startup_m12.c:786
msgid "CHAOS STILL CASTS A LONG SHADOW"
msgstr "카오스는 여전히 긴 그림자를 드리운다"

#: src/ui/menu_startup_m12.c:786 src/ui/menu_startup_m12.c:796
msgid "LORE SHAPE"
msgstr "이야기의 형태"

#: src/ui/menu_startup_m12.c:786
msgid "RETURNING CHAMPIONS FACE A HARDER MAZE"
msgstr "돌아온 챔피언들은 더 어려운 미로를 마주한다"

#: src/ui/menu_startup_m12.c:786
msgid "THE PLAYER HUNTS CORBUM MATERIAL"
msgstr "플레이어는 코르붐 물질을 찾아 나선다"

#: src/ui/menu_startup_m12.c:786
msgid "THE WORLD FEELS OLDER AND LESS SAFE"
msgstr "세계는 더 오래되고 덜 안전하게 느껴진다"

#: src/ui/menu_startup_m12.c:787 src/ui/menu_startup_m12.c:797
msgid "ARCHIVE STATUS"
msgstr "아카이브 상태"

#: src/ui/menu_startup_m12.c:787
msgid "CSBGRAPH DAT AND CSB DAT ARE TRACKED"
msgstr "CSBGRAPH.DAT와 CSB.DAT가 추적된다"

#: src/ui/menu_startup_m12.c:787
msgid "LAUNCHER SHOWS READY ONLY WHEN MATCHED"
msgstr "런처는 데이터가 일치할 때만 준비 완료로 표시한다"

#: src/ui/menu_startup_m12.c:787
msgid "MUSEUM CONTENT STAYS STATIC AND BOUNDED"
msgstr "박물관 콘텐츠는 고정되어 있고 범위가 제한된다"

#: src/ui/menu_startup_m12.c:787
msgid "VERSION SLOTS USE HASH EVIDENCE"
msgstr "버전 슬롯은 해시 증거를 사용한다"

#: src/ui/menu_startup_m12.c:793
msgid "THE LEGEND OUTSIDE THE FIRST DUNGEON"
msgstr "첫 번째 던전 너머의 전설"

#: src/ui/menu_startup_m12.c:795
msgid "DM2 KEEPS THE PARTY SURVIVAL CORE"
msgstr "DM2는 파티 생존의 핵심을 유지한다"

#: src/ui/menu_startup_m12.c:795
msgid "MINIONS AND WEATHER CHANGE THE RHYTHM"
msgstr "부하들과 날씨가 리듬을 바꾼다"

#: src/ui/menu_startup_m12.c:795
msgid "OUTDOOR AND SHOP SPACES EXPAND THE FORM"
msgstr "야외 공간과 상점이 형식을 확장한다"

#: src/ui/menu_startup_m12.c:795
msgid "THE SERIES MOVES BEYOND THE ORIGINAL MAZE"
msgstr "시리즈는 오리지널 미로를 넘어선다"

#: src/ui/menu_startup_m12.c:795
msgid "THE SKULLKEEP ERA"
msgstr "스컬킵의 시대"

#: src/ui/menu_startup_m12.c:796
msgid "TECHNOLOGY AND MAGIC SHARE THE STAGE"
msgstr "기술과 마법이 무대를 함께한다"

#: src/ui/menu_startup_m12.c:796
msgid "THE PLAYER ASSEMBLES AND SURVIVES"
msgstr "플레이어는 모으고 살아남는다"

