# =========================================================================
# Firestaff .gitignore
# =========================================================================
# Philosophy: aggressively exclude anything that isn't our hand-written
# source, docs, or scripts. Derived outputs, Fontanel extracts, and
# legacy `redmcsb_*` scratch MUST NOT ship.
# =========================================================================

# -------------------------------------------------------------------------
# Fontanel sources / extracts — NEVER SHIP (no licence granted)
# -------------------------------------------------------------------------
phase*-ref/
dm7z-extract/
# Note: on case-insensitive filesystems (macOS default) we cannot simply
# ignore `*.C` without also ignoring our `*.c` sources. The directory-level
# excludes above catch all known Fontanel uppercase `.C` files.

# -------------------------------------------------------------------------
# Derived from Fontanel game data (graphics extracts, analysis dumps)
# -------------------------------------------------------------------------
analysis_m4/
palette-recovery/
phase11-fixtures/
extracted-graphics-v1/
visible-exports/
visible-exports-filtered/
exports_*/
extraction-tools/

# -------------------------------------------------------------------------
# Verification / matrix output — regenerated by run_firestaff_m10_verify.sh
# -------------------------------------------------------------------------
verification/
verification-m10/
internal-matrix/
submenu-matrix/
roundtrip-matrix/

# -------------------------------------------------------------------------
# Legacy `redmcsb_*` scratch (pre-rename research notes, analysis tools,
# intermediate probes). Not part of the public Firestaff project.
# -------------------------------------------------------------------------
redmcsb_*
*_redmcsb_*
analyze_redmcsb_*.py
build_redmcsb_*.py
audit_redmcsb_*.py
bootstrap_redmcsb_*.py
copy_redmcsb_*.py
generate_redmcsb_*.py
inspect_redmcsb_*.py
test_copy_redmcsb_*.py
flatten_redmcsb_*.py
map_redmcsb_*.py
scan_redmcsb_*.py
select_redmcsb_*.py
split_redmcsb_*.py
# Pass 47 reference-capture tooling is tracked (see
# parity-evidence/pass47_reference_capture_tooling.md).
!tools/redmcsb_reference_compose.py
!tools/redmcsb_overlay_diff.py

# -------------------------------------------------------------------------
# Build artefacts (rebuilt by probe scripts)
# -------------------------------------------------------------------------
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.bin
*_bin
*_probe
*_probe_bin
*_harness
*_integration

# Specific top-level binary outputs
firestaff_headless
/firestaff
firestaff-*-quicksave.sav
firestaff-*-quicksave.sav.*
exports_driver_probe_*
test_*_pc34_compat
test_vga_palette

# Built/dumped images and traces (scratch output of probes).
# verification-screens raw/crop PNG/PPM payloads stay out of git; keep
# small repo-friendly evidence manifests (md/json/tsv/log/conf/txt/scripts) trackable.
*.pgm
*.ppm
*.png
verification-screens/**/*.ppm
verification-screens/**/*.png
!verification-screens/**/*.md
!verification-screens/**/*.json
!verification-screens/**/*.tsv
!verification-screens/**/*.conf
!verification-screens/**/*.txt
!verification-screens/**/*.sh
!verification-screens/**/*.swift
!assets/branding/*.png
!assets/cards/creatures/*.png
!assets-v2/creatures/wave1/**/*.png
# Pass 47 reference artifacts — tracked (source-anchored composites
# of extracted DM1 PC 3.4 GRAPHICS.DAT bitmaps + recovered VGA palette).
!reference-artifacts/**/*.png
!reference-artifacts/**/*.ppm
*.log
!verification-screens/**/*manifest*.log
tmp_probe_*
startup_dispatch_*

# Pass 47 DOSBox-staged game tree and runtime captures (not tracked;
# regenerated by scripts/dosbox_dm1_capture.sh).
verification-screens/dm1-dosbox-capture/
verification-screens/pass70-original-dm1-viewports/

# -------------------------------------------------------------------------
# Internal docs that explicitly reference Fontanel's source archive, file
# names, or struct layouts by his naming convention. Kept on disk for our
# own reference; not shipped until licence status is clarified.
# -------------------------------------------------------------------------
dm7z_integration_*.md
dungeon_format_notes_*.md
dungeon_format_confirmation_*.md
byteops_backend_pc34_legacy_contract.md
image_backend_pc34_legacy_contract.md

# -------------------------------------------------------------------------
# Per-user scratch, drafts, and editor state
# -------------------------------------------------------------------------
dm-forum-announcement.md
.DS_Store
*.bak
*.orig
*~
*.tmp
*.swp
*.swo
.vscode/
.idea/
.cache/
build/
cmake-build-*/
*.dSYM/
compile_commands.json

# Python caches
__pycache__/
*.pyc
*.pyo

# -------------------------------------------------------------------------
# Absolute /tmp paths should never be in-tree
# -------------------------------------------------------------------------
/tmp/

# Local release packaging/staging outputs (rebuilt outside source control)
/release/

# Local handoff/temp full-tree snapshots from worker passes
/firestaff-hud-toprow-clean-*/

# Failed/partial original-route scratch attempt with no raw gameplay captures
/verification-screens/pass86-original-route-dm-vv-sn-pk/

