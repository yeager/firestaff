# CMake build output
/build/

# Gettext binary catalogs are generated from tracked .po sources by CMake.
*.mo

# Ephemeral corpora emitted by DM1 PC34 capture tests.
firestaff_dm1_pc34_corpus_*/

# Local, read-only third-party source checkout used by optional DM2 source-lock
# verifiers.  It is never a Firestaff runtime or release dependency.
/reference/skproject/

# User-supplied firmware and optical-disc/game media never belong in Git.
*.pce
*.rom
*.bin
*.cue
*.iso
*.mdf
*.mds
/bios/
/firmware/
